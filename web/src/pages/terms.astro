---
/**
 * Terms of Use — the site's current terms, in plain language. Internal
 * notes on legal review, governing-law language, and contracting-party
 * status live in docs/content-rights-checklist.md, not on this public page.
 */

import LegalPage from "../layouts/LegalPage.astro";
import siteConfig, { formatPageTitle } from "../data/siteConfig";

const title = formatPageTitle("Terms of Use");
const description = `The terms that govern use of ${siteConfig.bandNameFormal}'s website.`;
const email = siteConfig.contact.email;
---

<LegalPage
  title={title}
  description={description}
  kicker="Legal"
  heading="Terms of Use"
  effectiveDate="August 15, 2026"
>
  <p>
    These Terms of Use govern your use of this website, operated by The Electric Lavender Train
    (“we,” “us,” or “our”). By using this website, you agree to these terms.
  </p>

  <h2>Informational use</h2>
  <p>
    This website is provided for informational purposes — to share information about The Electric
    Lavender Train, our upcoming and past shows, photos and video, merchandise, and how to reach us.
  </p>

  <h2>Booking inquiries are not a confirmed booking</h2>
  <p>
    Submitting the Booking Inquiry form, or contacting us by email, does not create a confirmed
    booking, reservation, or contract of any kind. A booking is confirmed only once we and you have
    entered into a separate written agreement covering the details of the event, and any required
    payment has been made under the terms of that agreement. Nothing on this website should be
    relied upon as a guarantee of availability or a confirmed engagement until that has happened.
  </p>

  <h2>Merchandise inquiries are not purchases</h2>
  <p>
    This website does not have an online store, shopping cart, or checkout. Submitting the Merch
    Inquiry form is a request for information — it is not a purchase, an order, or a payment
    transaction, and it does not obligate either party to complete a sale. Please do not submit
    payment card numbers or other payment information through any form on this website; we do not
    request or accept payment information this way.
  </p>

  <h2>Permitted use</h2>
  <p>You may use this website for its intended informational and inquiry purposes. You agree not to:</p>
  <ul>
    <li>Use this website for any unlawful purpose;</li>
    <li>Attempt to gain unauthorized access to this website or its underlying systems;</li>
    <li>Submit false, abusive, or malicious content through any form on this site; or</li>
    <li>Use automated means to scrape, spam, or overload this website or its forms.</li>
  </ul>

  <h2>Ownership of content</h2>
  <p>
    Content on this website — including text, photographs, video, logos, and artwork — may be
    owned by, or licensed to, The Electric Lavender Train. You may not reproduce, distribute, or
    otherwise use content from this website beyond ordinary browsing without our permission, except
    as permitted by applicable law.
  </p>

  <h2>Third-party links and embedded services</h2>
  <p>
    This website links to and embeds content from third-party services (including social media
    platforms and YouTube). Those services have their own terms of use and privacy policies, which
    are not controlled by us. We are not responsible for the content, availability, or practices of
    any third-party service.
  </p>

  <h2>Disclaimers</h2>
  <p>
    This website and its content are provided “as is,” without warranties of any kind, to the
    extent permitted by law. We do not guarantee that this website will be uninterrupted,
    error-free, or completely secure. Information on this website (including show dates and
    availability) may change and may not always be current.
  </p>

  <h2>Limitation of liability</h2>
  <p>
    To the extent permitted by law, The Electric Lavender Train is not liable for any indirect,
    incidental, or consequential damages arising from your use of this website. Nothing in these
    Terms is intended to limit any liability that cannot be limited under applicable law.
  </p>

  <h2>Changes to these Terms</h2>
  <p>
    We may update these Terms of Use from time to time. Material changes will be reflected by
    updating the effective date at the top of this page. Continued use of this website after a
    change means you accept the updated Terms.
  </p>

  <h2>Contact us</h2>
  <p>
    Questions about these Terms of Use can be sent to <a href={`mailto:${email}`}>{email}</a>.
  </p>
</LegalPage>
