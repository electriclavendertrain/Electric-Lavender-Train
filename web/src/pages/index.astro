---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import AboutExperience from "../components/AboutExperience.astro";
import OfficialBandPhotos from "../components/OfficialBandPhotos.astro";
import UpcomingShows from "../components/UpcomingShows.astro";
import Testimonials from "../components/Testimonials.astro";
import BookingCTA from "../components/BookingCTA.astro";
import Newsletter from "../components/Newsletter.astro";
import siteConfig, { formatPageTitle } from "../data/siteConfig";
import { getNewsletterSignupUrl, getNewsletterUnsubscribeUrl } from "../lib/newsletter";
import {
  upcomingShowsFallback,
  testimonialsIntroFallback,
  homepageSeoFallback,
  heroFallback,
  experienceFallback,
  EXPERIENCE_HEADING_ID,
  bookingCtaFallback,
  newsletterFallback,
} from "../data/homeData";
import { sanityClient } from "../sanity/client";
import {
  HOMEPAGE_QUERY,
  UPCOMING_PUBLIC_EVENTS_QUERY,
  TESTIMONIALS_QUERY,
} from "../sanity/queries";
import {
  normalizeTestimonials,
  normalizeUpcomingEvents,
  normalizeOfficialBandPhotos,
  isHeroContentComplete,
  isBookingCtaComplete,
  isNewsletterComplete,
  isExperienceContentComplete,
  getHeroVideoUrl,
  getHeroVideoTitle,
  getOgImageUrl,
} from "../sanity/normalize";

// Strictness follows the configured dataset, not Astro's build mode.
const isProductionDataset = import.meta.env.PUBLIC_SANITY_DATASET === "production";

// Fetch independently and fail the build on real Sanity/configuration errors.
const [homepage, upcomingEvents, rawTestimonials] = await Promise.all([
  sanityClient.fetch(HOMEPAGE_QUERY),
  sanityClient.fetch(UPCOMING_PUBLIC_EVENTS_QUERY),
  sanityClient.fetch(TESTIMONIALS_QUERY),
]);

if (homepage === null && isProductionDataset) {
  throw new Error(
    "The Sanity `homepage` singleton is missing from the production dataset. " +
      "Publish it in Sanity Studio before building for production — see docs/developer-guide.md.",
  );
}

const singletonExists = homepage !== null;

// Never mix a partial live singleton with field-level fallback content.
const heroContent = singletonExists
  ? isHeroContentComplete(homepage.hero)
    ? homepage.hero
    : null
  : heroFallback;

const bookingCtaContent = singletonExists
  ? isBookingCtaComplete(homepage.bookingCta)
    ? homepage.bookingCta
    : null
  : bookingCtaFallback;

const newsletterContent = singletonExists
  ? isNewsletterComplete(homepage.newsletter, isProductionDataset)
    ? homepage.newsletter
    : null
  : newsletterFallback;

// The hosted signup/unsubscribe destinations are infrastructure configuration,
// not Sanity content — each is validated and rendered independently.
const newsletterSignupUrl = getNewsletterSignupUrl();
const newsletterUnsubscribeUrl = getNewsletterUnsubscribeUrl();

// A missing or invalid live video reference renders the static logo.
const heroVideoUrl = getHeroVideoUrl(homepage?.heroVideo);
const heroVideoTitle =
  getHeroVideoTitle(homepage?.heroVideo) ?? `${siteConfig.bandNameFormal} — Featured Video`;

// Shared testimonials render zero to three real documents with no fallback.
const testimonials = normalizeTestimonials(rawTestimonials);

// Each editorial block falls back as one unit outside production.
const hasCompleteUpcomingShowsContent = Boolean(
  homepage?.upcomingShows?.kicker &&
  homepage.upcomingShows.heading &&
  homepage.upcomingShows.viewAllLabel &&
  homepage.upcomingShows.emptyState?.title &&
  homepage.upcomingShows.emptyState.message &&
  homepage.upcomingShows.emptyState.actionLabel,
);
const upcomingShowsContent = hasCompleteUpcomingShowsContent
  ? homepage!.upcomingShows!
  : upcomingShowsFallback;

// Whitespace-only Experience fields do not count as complete.
const hasCompleteExperienceContent = isExperienceContentComplete(homepage?.experience);
const experienceContent = hasCompleteExperienceContent
  ? homepage!.experience!
  : experienceFallback;

const hasCompleteTestimonialsIntro = Boolean(
  homepage?.testimonialsIntro?.kicker && homepage.testimonialsIntro.heading,
);
const testimonialsIntro =
  hasCompleteTestimonialsIntro
  ? homepage!.testimonialsIntro!
  : testimonialsIntroFallback;

// Official photos are optional, have no fallback, and fail production only when invalid.
const officialBandPhotosResult = normalizeOfficialBandPhotos(
  homepage?.officialBandPhotos?.photos,
  isProductionDataset,
);
if (officialBandPhotosResult === null && isProductionDataset) {
  throw new Error(
    "The Sanity `homepage.officialBandPhotos` selection is invalid in the production dataset. " +
      "Every selected photo must resolve to a real image with alt text and no `[TEST` marker. " +
      "Fix or remove the invalid photo(s) in Sanity Studio before building for production " +
      "— this section has no fallback and is never substituted with Gallery images.",
  );
}
const officialBandPhotos = officialBandPhotosResult ?? [];
const officialBandPhotosHeading = homepage?.officialBandPhotos?.heading?.trim();
const officialBandPhotosCtaLabel = homepage?.officialBandPhotos?.ctaLabel?.trim();
const hasCompleteOfficialBandPhotos = Boolean(
  officialBandPhotosHeading &&
  officialBandPhotosCtaLabel &&
  officialBandPhotos.length > 0,
);

if (
  isProductionDataset &&
  (homepage?.officialBandPhotos?.photos?.length ?? 0) > 0 &&
  !hasCompleteOfficialBandPhotos
) {
  throw new Error(
    "The Sanity `homepage.officialBandPhotos` section is incomplete in the production dataset. " +
      "A selected official photo requires a heading, a Meet the Band button label, and valid image content. " +
      "Complete the section in Sanity Studio before building for production.",
  );
}

// Production owns all required editorial content; official photos remain optional.
if (
  isProductionDataset &&
  (!heroContent ||
    !hasCompleteExperienceContent ||
    !bookingCtaContent ||
    !newsletterContent ||
    !hasCompleteUpcomingShowsContent ||
    !hasCompleteTestimonialsIntro)
) {
  throw new Error(
    "The Sanity `homepage` singleton is incomplete in the production dataset. " +
      "Complete the hero, the ELT Experience section (heading, introduction, and " +
      "exactly three highlights each with a title and description), upcoming-shows " +
      "copy, testimonial heading, newsletter section, and booking call to action in " +
      "Studio before building for production.",
  );
}

const events = normalizeUpcomingEvents(upcomingEvents);

const title = formatPageTitle(homepage?.seo?.metaTitle || "Home");
const description = homepage?.seo?.metaDescription ?? homepageSeoFallback.metaDescription;
const ogImage = getOgImageUrl(homepage?.seo?.ogImage);
---

<BaseLayout title={title} description={description} ogImage={ogImage}>
  {
    heroContent && (
      <Hero
        eyebrow={heroContent.eyebrow}
        headline={heroContent.headline}
        subcopy={heroContent.subcopy}
        videoUrl={heroVideoUrl}
        videoTitle={heroVideoTitle}
      />
    )
  }

  {
    hasCompleteOfficialBandPhotos && (
      <OfficialBandPhotos
        kicker={homepage!.officialBandPhotos!.kicker}
        heading={officialBandPhotosHeading!}
        body={homepage!.officialBandPhotos!.body}
        ctaLabel={officialBandPhotosCtaLabel!}
        photos={officialBandPhotos}
      />
    )
  }

  <AboutExperience
    headingId={EXPERIENCE_HEADING_ID}
    kicker={experienceContent.kicker}
    heading={experienceContent.heading}
    introduction={experienceContent.introduction}
    highlights={experienceContent.highlights}
  />

  <UpcomingShows
    kicker={upcomingShowsContent.kicker}
    heading={upcomingShowsContent.heading}
    viewAllLabel={upcomingShowsContent.viewAllLabel}
    events={events}
    emptyStateTitle={upcomingShowsContent.emptyState.title}
    emptyStateMessage={upcomingShowsContent.emptyState.message}
    emptyStateActionLabel={upcomingShowsContent.emptyState.actionLabel}
  />

  <Testimonials
    kicker={testimonialsIntro.kicker}
    heading={testimonialsIntro.heading}
    items={testimonials}
  />

  {
    bookingCtaContent && (
      <BookingCTA
        kicker={bookingCtaContent.kicker}
        heading={bookingCtaContent.heading}
        body={bookingCtaContent.body}
        ctaLabel={bookingCtaContent.ctaLabel}
        balancedKicker={true}
      />
    )
  }

  {
    newsletterContent && (
      <Newsletter
        kicker={newsletterContent.kicker}
        heading={newsletterContent.heading}
        body={newsletterContent.body}
        ctaLabel={newsletterContent.ctaLabel}
        signupUrl={newsletterSignupUrl}
        unsubscribeUrl={newsletterUnsubscribeUrl}
      />
    )
  }
</BaseLayout>
