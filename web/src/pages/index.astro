---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import BandIntro from "../components/BandIntro.astro";
import UpcomingShows from "../components/UpcomingShows.astro";
import GalleryPreview from "../components/GalleryPreview.astro";
import Testimonials from "../components/Testimonials.astro";
import BookingCTA from "../components/BookingCTA.astro";
import siteConfig from "../data/siteConfig";
import {
  hero,
  heroVideoUrl,
  bandIntro,
  upcomingShowsCopy,
  galleryCopy,
  galleryItems,
  testimonialsCopy,
  testimonials,
  bookingCta,
} from "../data/homeData";
import { shows } from "../data/shows";

const title = `${siteConfig.bandNameFormal} (${siteConfig.bandNameShort}) — Central Coast's Favorite Dance Band`;
const description = siteConfig.tagline;
---

<BaseLayout title={title} description={description}>
  <Hero
    eyebrow={hero.eyebrow}
    headline={hero.headline}
    subcopy={hero.subcopy}
    videoUrl={heroVideoUrl}
  />

  <BandIntro
    kicker={bandIntro.kicker}
    heading={bandIntro.heading}
    paragraphs={bandIntro.paragraphs}
    ctaLabel={bandIntro.ctaLabel}
  />

  <UpcomingShows
    kicker={upcomingShowsCopy.kicker}
    heading={upcomingShowsCopy.heading}
    viewAllLabel={upcomingShowsCopy.viewAllLabel}
    placeholderNote={upcomingShowsCopy.placeholderNote}
    shows={shows}
    emptyStateTitle={upcomingShowsCopy.emptyStateTitle}
    emptyStateMessage={upcomingShowsCopy.emptyStateMessage}
  />

  <GalleryPreview
    kicker={galleryCopy.kicker}
    heading={galleryCopy.heading}
    ctaLabel={galleryCopy.ctaLabel}
    items={galleryItems}
  />

  <Testimonials
    kicker={testimonialsCopy.kicker}
    heading={testimonialsCopy.heading}
    placeholderNote={testimonialsCopy.placeholderNote}
    items={testimonials}
  />

  <BookingCTA
    kicker={bookingCta.kicker}
    heading={bookingCta.heading}
    body={bookingCta.body}
    ctaLabel={bookingCta.ctaLabel}
  />
</BaseLayout>
