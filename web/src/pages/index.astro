---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import AboutExperience from "../components/AboutExperience.astro";
import OfficialBandPhotos from "../components/OfficialBandPhotos.astro";
import UpcomingShows from "../components/UpcomingShows.astro";
import Testimonials from "../components/Testimonials.astro";
import BookingCTA from "../components/BookingCTA.astro";
import Newsletter from "../components/Newsletter.astro";
import siteConfig, { formatPageTitle } from "../data/siteConfig";
import { getNewsletterSignupUrl } from "../lib/newsletter";
import {
  upcomingShowsFallback,
  testimonialsIntroFallback,
  homepageSeoFallback,
  heroFallback,
  experienceFallback,
  EXPERIENCE_HEADING_ID,
  bookingCtaFallback,
  newsletterFallback,
} from "../data/homeData";
import { withTestimonialFallbacks } from "../data/testimonialsData";
import { sanityClient } from "../sanity/client";
import {
  HOMEPAGE_QUERY,
  UPCOMING_PUBLIC_EVENTS_QUERY,
  TESTIMONIALS_QUERY,
} from "../sanity/queries";
import {
  normalizeTestimonials,
  normalizeUpcomingEvents,
  normalizeOfficialBandPhotos,
  isHeroContentComplete,
  isBookingCtaComplete,
  isNewsletterComplete,
  isExperienceContentComplete,
  getHeroVideoUrl,
  getHeroVideoTitle,
  getOgImageUrl,
} from "../sanity/normalize";

// The production-vs-development policy is decided by which Sanity dataset
// is actually configured, not by Astro's own build mode — a "production"
// Astro build can legitimately point at the development dataset (e.g. a
// staging preview), and that must NOT trip the strict production
// requirement below (docs/phase3-plan.md §16).
const isProductionDataset = import.meta.env.PUBLIC_SANITY_DATASET === "production";

// Three independent queries, fetched in parallel. None is wrapped in a
// try/catch: a genuine failure (network, auth, malformed GROQ, config) throws
// here and fails the build, in every environment — the only cases handled
// below are *successful* queries that legitimately found nothing.
//
// TESTIMONIALS_QUERY is deliberately independent of the singleton: the same
// documents are fetched, unchanged, by /about.
const [homepage, upcomingEvents, rawTestimonials] = await Promise.all([
  sanityClient.fetch(HOMEPAGE_QUERY),
  sanityClient.fetch(UPCOMING_PUBLIC_EVENTS_QUERY),
  sanityClient.fetch(TESTIMONIALS_QUERY),
]);

if (homepage === null && isProductionDataset) {
  throw new Error(
    "The Sanity `homepage` singleton is missing from the production dataset. " +
      "Publish it in Sanity Studio before building for production — see docs/phase3-plan.md §16.",
  );
}

const singletonExists = homepage !== null;

// Hero/band-intro/booking-CTA are singular content blocks, not lists — if
// the singleton exists but one of them is incomplete, that section is
// omitted rather than patched with fallback text (never mix live Sanity
// content with placeholder copy in the same render). The fallback objects
// below are only ever used when the whole document is absent.
const heroContent = singletonExists
  ? isHeroContentComplete(homepage.hero)
    ? homepage.hero
    : null
  : heroFallback;

const bookingCtaContent = singletonExists
  ? isBookingCtaComplete(homepage.bookingCta)
    ? homepage.bookingCta
    : null
  : bookingCtaFallback;

const newsletterContent = singletonExists
  ? isNewsletterComplete(homepage.newsletter, isProductionDataset)
    ? homepage.newsletter
    : null
  : newsletterFallback;

// The signup button itself is entirely independent of the editorial content
// above — it appears only once a real hosted signup URL is configured
// outside Sanity (never a Studio-editable field: the destination provider is
// a code/infra decision, not editorial copy). See web/src/lib/newsletter.ts.
const newsletterSignupUrl = getNewsletterSignupUrl();

// The hero video always comes from the live query — there is no fallback
// URL. A missing or non-YouTube reference resolves to null here, and
// Hero.astro's own (Phase 2.5-approved, untouched) validation renders the
// static logo for null exactly as it always has.
const heroVideoUrl = getHeroVideoUrl(homepage?.heroVideo);
const heroVideoTitle =
  getHeroVideoTitle(homepage?.heroVideo) ?? `${siteConfig.bandNameFormal} — Featured Video`;

// Testimonials come from their own reusable documents and are entirely
// independent of whether the homepage singleton exists. Use the shared
// three-card fallback as one complete set in non-production until all three
// live documents are valid. Production requires all three; live and
// placeholder endorsements are never mixed in the same section.
const testimonials = withTestimonialFallbacks(
  normalizeTestimonials(rawTestimonials),
  !isProductionDataset,
);

// These editorial blocks were added after the original singleton was already
// in use. Each falls back as one complete unit while a non-production dataset
// is populated; individual Studio and fallback fields are never mixed.
const hasCompleteUpcomingShowsContent = Boolean(
  homepage?.upcomingShows?.kicker &&
  homepage.upcomingShows.heading &&
  homepage.upcomingShows.viewAllLabel &&
  homepage.upcomingShows.emptyState?.title &&
  homepage.upcomingShows.emptyState.message &&
  homepage.upcomingShows.emptyState.actionLabel,
);
const upcomingShowsContent = hasCompleteUpcomingShowsContent
  ? homepage!.upcomingShows!
  : upcomingShowsFallback;

// "The ELT Experience" — moved here from the About page. `isExperienceContentComplete`
// trims every string (heading, introduction, CTA label, and each highlight's
// title/description) before checking it, so a whitespace-only value can
// never pass as complete — see that function's doc comment in normalize.ts.
const hasCompleteExperienceContent = isExperienceContentComplete(homepage?.experience);
const experienceContent = hasCompleteExperienceContent
  ? homepage!.experience!
  : experienceFallback;

const hasCompleteTestimonialsIntro = Boolean(
  homepage?.testimonialsIntro?.kicker && homepage.testimonialsIntro.heading,
);
const testimonialsIntro =
  hasCompleteTestimonialsIntro
  ? homepage!.testimonialsIntro!
  : testimonialsIntroFallback;

// Official Band Photos — a restrained, Homepage-only, production-only
// showcase of professionally photographed official images. Unlike every
// other Homepage block, absence is always valid (the section is simply
// omitted — there is no fallback content, and fan/live Gallery images are
// never substituted), but a PRESENT-but-invalid selection is its own,
// independent production-fail condition — checked separately from the
// aggregate "singleton incomplete" throw below, since this block being
// entirely unset must never trip that throw.
const officialBandPhotosResult = normalizeOfficialBandPhotos(
  homepage?.officialBandPhotos?.photos,
  isProductionDataset,
);
if (officialBandPhotosResult === null && isProductionDataset) {
  throw new Error(
    "The Sanity `homepage.officialBandPhotos` selection is invalid in the production dataset. " +
      "Every selected photo must resolve to a real image with alt text and no `[TEST` marker. " +
      "Fix or remove the invalid photo(s) in Sanity Studio before building for production " +
      "— this section has no fallback and is never substituted with Gallery images.",
  );
}
const officialBandPhotos = officialBandPhotosResult ?? [];
const hasCompleteOfficialBandPhotos = Boolean(
  homepage?.officialBandPhotos?.heading && officialBandPhotos.length > 0,
);

// A production dataset must own all required Homepage editorial content in
// Studio. The code fallbacks are migration/development scaffolding, not a way
// to silently publish an incomplete production singleton. Official Band
// Photos is deliberately NOT included here — it's optional even in
// production; only a present-but-invalid selection fails the build (above).
if (
  isProductionDataset &&
  (!heroContent ||
    !hasCompleteExperienceContent ||
    !bookingCtaContent ||
    !newsletterContent ||
    !hasCompleteUpcomingShowsContent ||
    !hasCompleteTestimonialsIntro)
) {
  throw new Error(
    "The Sanity `homepage` singleton is incomplete in the production dataset. " +
      "Complete the hero, the ELT Experience section (heading, introduction, CTA label, and " +
      "exactly three highlights each with a title and description), upcoming-shows " +
      "copy, testimonial heading, newsletter section, and booking call to action in " +
      "Studio before building for production.",
  );
}

const events = normalizeUpcomingEvents(upcomingEvents);

const title = formatPageTitle(homepage?.seo?.metaTitle || "Home");
const description = homepage?.seo?.metaDescription ?? homepageSeoFallback.metaDescription;
const ogImage = getOgImageUrl(homepage?.seo?.ogImage);
---

<BaseLayout title={title} description={description} ogImage={ogImage}>
  {
    heroContent && (
      <Hero
        eyebrow={heroContent.eyebrow}
        headline={heroContent.headline}
        subcopy={heroContent.subcopy}
        videoUrl={heroVideoUrl}
        videoTitle={heroVideoTitle}
      />
    )
  }

  <AboutExperience
    headingId={EXPERIENCE_HEADING_ID}
    kicker={experienceContent.kicker}
    heading={experienceContent.heading}
    introduction={experienceContent.introduction}
    highlights={experienceContent.highlights}
    ctaLabel={experienceContent.ctaLabel}
  />

  {
    hasCompleteOfficialBandPhotos && (
      <OfficialBandPhotos
        kicker={homepage!.officialBandPhotos!.kicker}
        heading={homepage!.officialBandPhotos!.heading}
        body={homepage!.officialBandPhotos!.body}
        photos={officialBandPhotos}
      />
    )
  }

  <UpcomingShows
    kicker={upcomingShowsContent.kicker}
    heading={upcomingShowsContent.heading}
    viewAllLabel={upcomingShowsContent.viewAllLabel}
    events={events}
    emptyStateTitle={upcomingShowsContent.emptyState.title}
    emptyStateMessage={upcomingShowsContent.emptyState.message}
    emptyStateActionLabel={upcomingShowsContent.emptyState.actionLabel}
  />

  <Testimonials
    kicker={testimonialsIntro.kicker}
    heading={testimonialsIntro.heading}
    items={testimonials}
  />

  {
    bookingCtaContent && (
      <BookingCTA
        kicker={bookingCtaContent.kicker}
        heading={bookingCtaContent.heading}
        body={bookingCtaContent.body}
        ctaLabel={bookingCtaContent.ctaLabel}
        balancedKicker={true}
      />
    )
  }

  {
    newsletterContent && (
      <Newsletter
        kicker={newsletterContent.kicker}
        heading={newsletterContent.heading}
        body={newsletterContent.body}
        ctaLabel={newsletterContent.ctaLabel}
        signupUrl={newsletterSignupUrl}
      />
    )
  }
</BaseLayout>
