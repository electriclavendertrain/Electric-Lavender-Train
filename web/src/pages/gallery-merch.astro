---
/**
 * /gallery-merch — photos and inquiry-only merchandise.
 *
 * Renamed from `/media-merch` (visitor-facing "Media & Merch" → "Gallery &
 * Merchandise") — see docs/gallery-merch.md. A static-compatible redirect
 * from the old `/media-merch` path is configured in `astro.config.mjs`, not
 * a page file here (having both would conflict).
 *
 * This page's featured-video section was removed entirely, not migrated —
 * featured, click-to-load video locations are now only the Homepage hero
 * and the Music page.
 *
 * The redundant opening "Gallery and Merchandise" intro section was also
 * removed entirely (`galleryPage.intro` no longer exists) — the Media
 * Gallery is now the page's first visible section, and its own heading
 * supplies the page's one `<h1>` (see `MediaGallery.astro`'s `headingTag`/
 * `firstSection` props), rendered even when zero photos/videos are selected.
 *
 * This is the only file on this route that touches Sanity. It fetches,
 * hands the raw result straight to normalization, and passes plain objects
 * down; no component below it knows Sanity exists. Everything here runs
 * once, at `astro build` — nothing is fetched in the browser.
 */

import { getImage } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import MediaGallery from "../components/MediaGallery.astro";
import EventMediaSubmission from "../components/EventMediaSubmission.astro";
import MerchGrid from "../components/MerchGrid.astro";
import BookingCTA from "../components/BookingCTA.astro";
import siteConfig, { formatPageTitle, contactInquiryHref } from "../data/siteConfig";
import { galleryMerchCopy, galleryMerchFallback, galleryFallback, merchFallback } from "../data/galleryMerchData";
import { sanityClient } from "../sanity/client";
import { GALLERY_PAGE_QUERY } from "../sanity/queries";
import {
  normalizeGalleryPageContent,
  DEFAULT_OBJECT_POSITION,
  type NormalizedGalleryPageContent,
  type NormalizedGalleryPhoto,
  type NormalizedMerchItem,
} from "../sanity/normalize";

// Which policy applies is decided by the configured DATASET, not by Astro's
// build mode — a production-mode build may legitimately point at
// `development` (a staging preview), and that must not trip the strict
// requirements below. Matches every other route's convention exactly.
const isProductionDataset = import.meta.env.PUBLIC_SANITY_DATASET === "production";

const rawGalleryPage = await sanityClient.fetch(GALLERY_PAGE_QUERY);

// The curated gallery/merch selections get strict, item-level validation in
// production (see normalize.ts's module doc comment on this section) — any
// invalid selected entry fails the whole build there, and is silently
// dropped everywhere else.
const normalizedGalleryPage = normalizeGalleryPageContent(rawGalleryPage, {
  strict: isProductionDataset,
});

if (normalizedGalleryPage === null && isProductionDataset) {
  throw new Error(
    "The Sanity `galleryPage` singleton is missing or incomplete in the production dataset. " +
      "The gallery heading (this page's only heading) and inquiry call-to-action must be " +
      "complete; every selected gallery photo must resolve with an image, alt text, a known " +
      "category, and (if supplied) a valid credit URL; and every selected merchandise item " +
      "must have a name and description with no `[TEST — CLIENT PRODUCT REQUIRED]` marker and " +
      "a resolvable image if one is supplied. Publish the Gallery & Merchandise Page in Sanity " +
      "Studio before building for production — see docs/gallery-merch.md.",
  );
}

/**
 * The development fallback is ONE complete block, used only when the whole
 * singleton is absent — never patched field by field onto partial live
 * content. It has no featured video at all — this page no longer has a
 * featured-video section (see the module doc comment above).
 */
let pageContent: NormalizedGalleryPageContent;

// Mirrors normalize.ts's GALLERY_THUMB_WIDTH / GALLERY_LIGHTBOX_WIDTH: two
// bounded sizes, never a third undisplayed one, and never the unbounded
// original — matching the live Sanity path exactly (docs/gallery-merch.md §13).
const FALLBACK_THUMB_WIDTH = 700;
const FALLBACK_LIGHTBOX_WIDTH = 1600;

if (normalizedGalleryPage) {
  pageContent = normalizedGalleryPage;
} else {
  const galleryItems: NormalizedGalleryPhoto[] = await Promise.all(
    galleryFallback.map(async (item) => {
      const [thumb, full] = await Promise.all([
        getImage({ src: item.image, width: FALLBACK_THUMB_WIDTH }),
        getImage({ src: item.image, width: FALLBACK_LIGHTBOX_WIDTH }),
      ]);
      const thumbWidth = Number(thumb.attributes.width ?? FALLBACK_THUMB_WIDTH);
      const thumbHeight = Number(thumb.attributes.height ?? thumbWidth);
      const fullWidth = Number(full.attributes.width ?? FALLBACK_LIGHTBOX_WIDTH);
      const fullHeight = Number(full.attributes.height ?? fullWidth);
      return {
        _key: item._key,
        title: item.alt,
        alt: item.alt,
        category: item.category,
        thumbnail: {
          src: thumb.src,
          width: thumbWidth,
          height: thumbHeight,
          objectPosition: DEFAULT_OBJECT_POSITION,
        },
        full: { src: full.src, width: fullWidth, height: fullHeight },
        credit: item.credit,
      };
    }),
  );

  const merchItems: NormalizedMerchItem[] = [];
  for (const item of merchFallback) {
    let image: NormalizedMerchItem["image"] = null;
    if (item.image && item.alt) {
      const optimized = await getImage({ src: item.image, width: 640 });
      const width = Number(optimized.attributes.width ?? 640);
      const height = Number(optimized.attributes.height ?? width);
      image = { src: optimized.src, width, height, objectPosition: DEFAULT_OBJECT_POSITION, alt: item.alt };
    }
    merchItems.push({
      _id: item._id,
      name: item.name,
      description: item.description,
      image,
      priceDisplay: item.priceDisplay,
      availabilityNote: item.availabilityNote,
    });
  }

  pageContent = {
    gallery: {
      kicker: galleryMerchFallback.gallery.kicker,
      heading: galleryMerchFallback.gallery.heading,
      body: galleryMerchFallback.gallery.body,
      items: galleryItems,
      // The development fallback stays photo-only, deliberately — gallery
      // videos are exercised with local fixtures/mocks during verification,
      // never seeded into this permanent fallback (no Sanity write either
      // way). An empty selection is a fully valid, unchanged state.
      videos: [],
      hasPerformance: galleryItems.some((item) => item.category === "performance"),
      hasVenueCrowd: galleryItems.some((item) => item.category === "venue-crowd"),
      hasVideos: false,
    },
    // Off by default in the development fallback, exactly like the gallery
    // videos above — this is an approved, planned feature pending a real
    // Google Form, not something to demonstrate with fabricated content.
    eventMediaSubmission: null,
    merch: {
      kicker: galleryMerchFallback.merch.kicker,
      heading: galleryMerchFallback.merch.heading,
      body: galleryMerchFallback.merch.body,
      items: merchItems,
    },
    bookingCta: galleryMerchFallback.bookingCta,
    seo: {
      metaTitle: galleryMerchFallback.seo.metaTitle,
      metaDescription: galleryMerchFallback.seo.metaDescription,
      // Deliberately null: this page's share image is its own field and
      // never inherits another route's.
      ogImageUrl: null,
    },
  };
}

const title = formatPageTitle(pageContent.seo.metaTitle ?? "Gallery & Merchandise");
const description = pageContent.seo.metaDescription ?? siteConfig.tagline;

// Merchandise inquiries are an internal Contact-page email flow, not
// Instagram — see docs/contact-booking.md and docs/gallery-merch.md §8. This
// is an ordinary internal link: no new tab, no external-link notice.
const inquiryHref = contactInquiryHref("merch");
---

<BaseLayout title={title} description={description} ogImage={pageContent.seo.ogImageUrl}>
  <MediaGallery
    headingTag="h1"
    firstSection={true}
    headingId={galleryMerchCopy.gallery.headingId}
    kicker={pageContent.gallery.kicker}
    heading={pageContent.gallery.heading}
    body={pageContent.gallery.body}
    items={pageContent.gallery.items}
    videos={pageContent.gallery.videos}
    hasPerformance={pageContent.gallery.hasPerformance}
    hasVenueCrowd={pageContent.gallery.hasVenueCrowd}
    hasVideos={pageContent.gallery.hasVideos}
  />

  {
    pageContent.eventMediaSubmission && (
      <EventMediaSubmission
        kicker={pageContent.eventMediaSubmission.kicker}
        heading={pageContent.eventMediaSubmission.heading}
        explanation={pageContent.eventMediaSubmission.explanation}
        ctaLabel={pageContent.eventMediaSubmission.ctaLabel}
        formUrl={pageContent.eventMediaSubmission.formUrl}
      />
    )
  }

  <MerchGrid
    headingId={galleryMerchCopy.merch.headingId}
    kicker={pageContent.merch.kicker}
    heading={pageContent.merch.heading}
    body={pageContent.merch.body}
    items={pageContent.merch.items}
  />

  <BookingCTA
    kicker={pageContent.bookingCta.kicker}
    heading={pageContent.bookingCta.heading}
    body={pageContent.bookingCta.body}
    ctaLabel={pageContent.bookingCta.ctaLabel}
    balancedKicker={true}
    href={inquiryHref}
  />
</BaseLayout>
