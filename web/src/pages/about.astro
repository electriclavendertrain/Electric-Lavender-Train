---
/** Builds About from one page singleton plus shared testimonials. */

import { getImage } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import AboutHero from "../components/AboutHero.astro";
import BandMembers from "../components/BandMembers.astro";
import AboutPageJsonLd from "../components/AboutPageJsonLd.astro";
import Testimonials from "../components/Testimonials.astro";
import TestimonialSubmission from "../components/TestimonialSubmission.astro";
import BookingCTA from "../components/BookingCTA.astro";
import siteConfig, { formatPageTitle } from "../data/siteConfig";
import {
  aboutPageCopy,
  aboutPageFallback,
  aboutHeroFallbackImage,
  aboutHeroFallbackAlt,
  memberProfileFallbackAssets,
} from "../data/aboutData";
import { sanityClient } from "../sanity/client";
import { ABOUT_PAGE_QUERY, TESTIMONIALS_QUERY } from "../sanity/queries";
import {
  normalizeAboutPageContent,
  normalizeTestimonials,
  DEFAULT_OBJECT_POSITION,
  type NormalizedAboutPageContent,
} from "../sanity/normalize";

// Strictness follows the configured dataset, not Astro's build mode.
const isProductionDataset = import.meta.env.PUBLIC_SANITY_DATASET === "production";

// Fetch the page and shared testimonials independently; real query errors fail the build.
const [rawAboutPage, rawTestimonials] = await Promise.all([
  sanityClient.fetch(ABOUT_PAGE_QUERY),
  sanityClient.fetch(TESTIMONIALS_QUERY),
]);

// Reject placeholder biographies from production.
const normalizedAboutPage = normalizeAboutPageContent(rawAboutPage, {
  rejectTestBiographies: isProductionDataset,
});

if (normalizedAboutPage === null && isProductionDataset) {
  throw new Error(
    "The Sanity `aboutPage` singleton is missing or incomplete in the production dataset. " +
      "Every member must resolve with a name, role, profile photo and a real biography " +
      "(no `[TEST — CLIENT BIO REQUIRED]` text), the \"Who We Are\" introduction (heading, " +
      "1-2 paragraphs, hero image with alt text) and the booking section must be complete. " +
      "Publish the About Page in Sanity Studio before building for production — see docs/developer-guide.md.",
  );
}

/** The development fallback is ONE complete block and is allowed only outside production. */
let pageContent: NormalizedAboutPageContent;

if (normalizedAboutPage) {
  pageContent = normalizedAboutPage;
} else {
  const optimizedHero = await getImage({ src: aboutHeroFallbackImage, width: 1100 });
  pageContent = {
    ...aboutPageFallback,
    intro: {
      ...aboutPageFallback.intro,
      heroImage: {
        src: optimizedHero.src,
        width: Number(optimizedHero.attributes.width ?? 1100),
        height: Number(optimizedHero.attributes.height ?? 825),
        objectPosition: DEFAULT_OBJECT_POSITION,
        alt: aboutHeroFallbackAlt,
      },
    },
    // Do not fabricate a Google Form destination in fallback content.
    testimonialSubmission: null,
    members: await Promise.all(
      aboutPageFallback.members.map(async (member) => {
        const fallbackAsset = memberProfileFallbackAssets[member.profileImageFallbackKey];
        const optimized = await getImage({ src: fallbackAsset.src, width: 900 });
        return {
          _id: member._id,
          name: member.name,
          role: member.role,
          biography: member.biography,
          image: {
            src: optimized.src,
            width: Number(optimized.attributes.width ?? fallbackAsset.src.width),
            height: Number(optimized.attributes.height ?? fallbackAsset.src.height),
            alt: fallbackAsset.alt,
            objectPosition: fallbackAsset.objectPosition,
            credit: null,
          },
          // Never invent public links for fallback members.
          links: [],
        };
      }),
    ),
    seo: {
      metaTitle: aboutPageFallback.seo.metaTitle,
      metaDescription: aboutPageFallback.seo.metaDescription,
      // Page-specific SEO never inherits the Homepage image.
      ogImageUrl: null,
    },
  };
}

// Zero to three shared testimonials render; an empty list omits the section.
const testimonials = normalizeTestimonials(rawTestimonials);

const title = formatPageTitle(pageContent.seo.metaTitle ?? "About");
const description = pageContent.seo.metaDescription ?? siteConfig.tagline;

// Matches what BaseLayout emits as this page's canonical URL, so the
// structured data and the `<link rel="canonical">` cannot disagree.
const pageUrl = new URL(siteConfig.routes.about, siteConfig.siteUrl).href;
---

<BaseLayout title={title} description={description} ogImage={pageContent.seo.ogImageUrl}>
  {/*
    Set before first paint, and only when modal dialogs are actually usable.
    While this class is absent, `MemberProfileDialog`'s `:target` rules keep
    every profile reachable — so a deep link never flashes the fallback panel,
    and an unsupported browser never loses the biographies.
  */}
  <script is:inline>
    if (
      typeof HTMLDialogElement !== "undefined" &&
      typeof HTMLDialogElement.prototype.showModal === "function"
    ) {
      document.documentElement.classList.add("js-dialogs");
    }
  </script>

  <AboutPageJsonLd members={pageContent.members} pageUrl={pageUrl} />

  <AboutHero
    kicker={pageContent.intro.kicker}
    heading={pageContent.intro.heading}
    paragraphs={pageContent.intro.paragraphs}
    image={pageContent.intro.heroImage}
  />

  <BandMembers
    headingId={aboutPageCopy.membersHeadingId}
    kicker={pageContent.membersIntro.kicker}
    heading={pageContent.membersIntro.heading}
    body={pageContent.membersIntro.body}
    members={pageContent.members}
  />

  <Testimonials
    kicker={pageContent.testimonialsIntro.kicker}
    heading={pageContent.testimonialsIntro.heading}
    items={testimonials}
    newTabSuffix={aboutPageCopy.newTabSuffix}
  />

  {
    pageContent.testimonialSubmission && (
      <TestimonialSubmission
        kicker={pageContent.testimonialSubmission.kicker}
        heading={pageContent.testimonialSubmission.heading}
        explanation={pageContent.testimonialSubmission.explanation}
        ctaLabel={pageContent.testimonialSubmission.ctaLabel}
        formUrl={pageContent.testimonialSubmission.formUrl}
      />
    )
  }

  <BookingCTA
    kicker={pageContent.bookingCta.kicker}
    heading={pageContent.bookingCta.heading}
    body={pageContent.bookingCta.body}
    ctaLabel={pageContent.bookingCta.ctaLabel}
    balancedKicker={true}
  />
</BaseLayout>
