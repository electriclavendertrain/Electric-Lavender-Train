---
import BaseLayout from "../layouts/BaseLayout.astro";
import siteConfig, { formatPageTitle } from "../data/siteConfig";

const title = formatPageTitle("Page Not Found");
const description =
  "That page could not be found. Return home, browse upcoming shows, or meet Electric Lavender Train.";
---

<BaseLayout title={title} description={description} noIndex={true}>
  <section class="not-found" aria-labelledby="not-found-title">
    <div class="not-found-inner">
      <p class="error-code" aria-hidden="true">404</p>
      <p class="kicker">End of the Line</p>
      <h1 id="not-found-title">This stop isn’t on the line.</h1>
      <p class="not-found-copy">
        This page may have moved, or the address may be off track. You can head home, see where
        the band is playing, or meet the people aboard the train.
      </p>
      <nav class="not-found-actions" aria-label="Page not found options">
        <a class="btn btn-primary" href={siteConfig.routes.home}>Return Home</a>
        <a class="btn btn-outline" href={siteConfig.routes.shows}>View Shows</a>
        <a class="text-link" href={siteConfig.routes.about}>Meet the Band</a>
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: clamp(620px, 82vh, 860px);
    padding: clamp(150px, 18vw, 210px) 24px clamp(88px, 12vw, 140px);
    display: grid;
    place-items: center;
    text-align: center;
  }

  .not-found-inner {
    width: min(100%, 760px);
    position: relative;
    isolation: isolate;
  }

  .error-code {
    position: absolute;
    z-index: -1;
    top: 46%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-family: var(--display);
    font-size: clamp(9rem, 28vw, 18rem);
    line-height: 0.8;
    color: rgba(185, 147, 214, 0.08);
    user-select: none;
  }

  .kicker {
    justify-content: center;
    margin-bottom: 22px;
  }

  .kicker::before {
    content: "";
    flex: 0 0 40px;
    height: 1px;
    background: var(--gold);
    opacity: 0.5;
  }

  h1 {
    max-width: 700px;
    margin-inline: auto;
    font-size: clamp(2.6rem, 7vw, 5.4rem);
    line-height: 1.03;
  }

  .not-found-copy {
    max-width: 610px;
    margin: 26px auto 0;
    color: var(--cream);
    font-size: clamp(1rem, 2vw, 1.15rem);
    line-height: 1.75;
  }

  .not-found-actions {
    margin-top: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 14px;
  }

  .text-link {
    min-height: 44px;
    padding: 10px 8px;
    display: inline-flex;
    align-items: center;
    color: var(--cream);
    font-weight: 600;
    text-underline-offset: 5px;
  }

  .text-link:hover {
    color: var(--lavender);
  }

  @media (max-width: 520px) {
    .not-found-actions {
      align-items: stretch;
      flex-direction: column;
    }

    .not-found-actions .btn,
    .text-link {
      justify-content: center;
      width: 100%;
    }
  }
</style>
