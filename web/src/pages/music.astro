---
/**
 * /music — ELT's own released music only, with streaming/watch links and an
 * optional page-level featured video. No other Heavy Crush artist's music
 * appears here, no lyrics, no detailed public credits, no audio hosting, and
 * no raw media-file upload system — see docs for the full constraint list
 * this route was built against.
 *
 * Visible order: Featured (always rendered, supplies the page's one `<h1>`)
 * → Releases (released music only — no Upcoming Releases section, empty
 * state, or countdown) → Heavy Crush Records label affiliation (moved here
 * from the About page).
 *
 * This is the only file on this route that touches Sanity. It fetches,
 * hands the raw result straight to normalization, and passes plain objects
 * down; no component below it knows Sanity exists. Everything here runs
 * once, at `astro build` — nothing is fetched in the browser.
 */

import BaseLayout from "../layouts/BaseLayout.astro";
import Featured from "../components/FeaturedVideo.astro";
import MusicReleaseCard from "../components/MusicReleaseCard.astro";
import LabelAffiliation from "../components/LabelAffiliation.astro";
import siteConfig, { formatPageTitle } from "../data/siteConfig";
import { musicPageCopy, musicPageFallback } from "../data/musicData";
import { sanityClient } from "../sanity/client";
import { MUSIC_PAGE_QUERY } from "../sanity/queries";
import { normalizeMusicPageContent, type NormalizedMusicPageContent } from "../sanity/normalize";

const isProductionDataset = import.meta.env.PUBLIC_SANITY_DATASET === "production";

const rawMusicPage = await sanityClient.fetch(MUSIC_PAGE_QUERY);

// The curated release selection gets strict, item-level validation in
// production (see normalize.ts's module doc comment) — any invalid selected
// *released* release fails the whole build there, and is silently dropped
// everywhere else. An upcoming release is defensively excluded before it
// ever reaches that validation (see `normalizeMusicReleases`), so it can
// never fail a production build regardless of its content.
const normalizedMusicPage = normalizeMusicPageContent(rawMusicPage, {
  strict: isProductionDataset,
});

if (normalizedMusicPage === null && isProductionDataset) {
  throw new Error(
    "The Sanity `musicPage` singleton is missing or incomplete in the production dataset. " +
      "The Featured section's heading must be complete, and every selected released release " +
      "must resolve with a title, a recognized state, and a valid release date. Publish the " +
      "Music Page in Sanity Studio before building for production.",
  );
}

/**
 * The development fallback is ONE complete block, used only when the whole
 * singleton is absent — and deliberately carries zero releases rather than
 * inventing any (see `musicData.ts`'s module doc comment). This is
 * structurally unreachable once `PUBLIC_SANITY_DATASET` is `production`
 * (the `throw` above already fired by the time execution could reach here).
 */
const pageContent: NormalizedMusicPageContent = normalizedMusicPage ?? {
  featured: musicPageFallback.featured,
  releases: [],
  labelAffiliation: null,
  seo: { metaTitle: musicPageFallback.seo.metaTitle, metaDescription: musicPageFallback.seo.metaDescription, ogImageUrl: null },
};

const featuredVideoTitle = pageContent.featured.video?.title ?? `${siteConfig.bandNameFormal} — Featured Video`;

// Independently optional (see normalize.ts's doc comment on this field):
// falls back to the same approved facts already recorded in
// `siteConfig.heavyCrushRecords` rather than to a `[TEST]`-marked
// placeholder — these are real, approved, safe-to-publish facts, not
// content standing in for something the client hasn't provided yet. One
// coherent block, same as the live value: this fallback is never merged
// field-by-field with a partially-complete live `labelAffiliation`.
const labelAffiliation = pageContent.labelAffiliation ?? {
  kicker: null,
  text: siteConfig.heavyCrushRecords.relationshipText,
  logoAlt: "Heavy Crush Records logo",
  url: siteConfig.heavyCrushRecords.url,
  missionStatement: siteConfig.heavyCrushRecords.missionStatement,
  socialLinks: siteConfig.heavyCrushRecords.socialLinks,
};

const title = formatPageTitle(pageContent.seo.metaTitle ?? musicPageFallback.seo.metaTitle);
const description = pageContent.seo.metaDescription ?? musicPageFallback.seo.metaDescription;
---

<BaseLayout title={title} description={description} ogImage={pageContent.seo.ogImageUrl}>
  <Featured
    kicker={pageContent.featured.kicker}
    heading={pageContent.featured.heading}
    videoId={pageContent.featured.video?.videoId ?? null}
    videoTitle={featuredVideoTitle}
  />

  <section class="music-section" aria-labelledby={musicPageCopy.releasedHeadingId}>
    <div class="section-inner">
      <h2 id={musicPageCopy.releasedHeadingId} class="music-section__heading reveal">
        {musicPageCopy.releasedHeading}
      </h2>
      {
        pageContent.releases.length > 0 ? (
          <ul class="music-grid" role="list">
            {pageContent.releases.map((release) => (
              <MusicReleaseCard release={release} />
            ))}
          </ul>
        ) : (
          <p class="music-section__empty reveal">{musicPageCopy.emptyReleasedMessage}</p>
        )
      }
    </div>
  </section>

  <LabelAffiliation
    kicker={labelAffiliation.kicker}
    text={labelAffiliation.text}
    logoAlt={labelAffiliation.logoAlt}
    url={labelAffiliation.url}
    missionStatement={labelAffiliation.missionStatement}
    facebookUrl={labelAffiliation.socialLinks.facebookUrl}
    instagramUrl={labelAffiliation.socialLinks.instagramUrl}
    youtubeUrl={labelAffiliation.socialLinks.youtubeUrl}
    newTabSuffix={musicPageCopy.newTabSuffix}
  />
</BaseLayout>

<style>
  .music-section__heading {
    margin-bottom: 32px;
  }
  .music-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 26px;
  }
  .music-section__empty {
    color: rgba(244, 232, 208, 0.65);
    max-width: 60ch;
  }
</style>
