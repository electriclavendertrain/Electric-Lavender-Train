---
/**
 * The compact member card: photograph, name, role, and one real control that
 * opens that member's profile.
 *
 * Two things this deliberately does NOT do, both copied from the functional
 * reference's mistakes rather than its good ideas:
 *
 * - The `<article>` is not given `tabindex="0"`. A static card is not a
 *   control; making it focusable puts a stop in the tab order that does
 *   nothing when activated.
 * - The action does not pretend a member page exists. Its `href` points at
 *   this member's profile dialog on this page — which is a real destination
 *   with or without scripting — not at a `/about/<slug>` route that would 404.
 */

import type { NormalizedBandMember } from "../sanity/normalize";
import { aboutPageCopy } from "../data/aboutData";

interface Props {
  member: NormalizedBandMember;
  dialogId: string;
}

const { member, dialogId } = Astro.props;

/**
 * "Meet Rachel" reads better than "Meet Rachel Santa Cruz", but a screen
 * reader's list of controls needs each one to be distinguishable — so the rest
 * of the name is present and hidden only visually. A single-word name simply
 * has nothing to append.
 */
const [firstName, ...restOfName] = member.name.split(/\s+/).filter(Boolean);
const actionVisible = firstName
  ? `${aboutPageCopy.memberCardActionPrefix} ${firstName}`
  : aboutPageCopy.memberCardActionFallback;
const actionHiddenSuffix = restOfName.length > 0 ? ` ${restOfName.join(" ")}` : "";
---

<article class="member-card">
  <div class="member-card__frame">
    <img
      src={member.image.src}
      width={member.image.width}
      height={member.image.height}
      alt={member.image.alt}
      loading="lazy"
      decoding="async"
      style={`--focal-point: ${member.image.objectPosition}`}
    />
  </div>

  <div class="member-card__body">
    <h3 class="member-card__name">{member.name}</h3>
    <p class="member-card__role">{member.role}</p>

    <a class="member-card__action" href={`#${dialogId}`} data-member-dialog-open={dialogId}>
      {actionVisible}
      {actionHiddenSuffix && <span class="visually-hidden">{actionHiddenSuffix}</span>}
    </a>
  </div>
</article>

<style>
  .member-card {
    display: flex;
    flex-direction: column;
    background: linear-gradient(160deg, rgba(90, 62, 123, 0.18), rgba(11, 11, 18, 0.4));
    border: 1px solid rgba(160, 123, 239, 0.25);
    border-radius: 18px;
    overflow: hidden;
    transition: transform 0.35s var(--ease), border-color 0.35s, box-shadow 0.35s;
  }
  .member-card:hover {
    transform: translateY(-6px);
    border-color: var(--lavender);
    box-shadow: 0 20px 44px rgba(90, 62, 123, 0.35);
  }
  /* The card lifts when the control inside it is keyboard-focused, so keyboard
     and pointer users get the same affordance. The gold focus ring on the
     control itself is what actually communicates focus. */
  .member-card:focus-within {
    border-color: var(--lavender);
  }

  .member-card__frame {
    position: relative;
    background: rgba(11, 11, 18, 0.6);
  }
  .member-card__frame img {
    width: 100%;
    height: 100%;
    /* Fixed by CSS, so the intrinsic width/height attributes reserve the right
       box and the image cannot shift the grid as it loads. */
    aspect-ratio: 1 / 1;
    object-fit: cover;
    object-position: var(--focal-point, 50% 50%);
  }

  .member-card__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    padding: 22px 22px 24px;
  }
  .member-card__name {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--warm-white);
    line-height: 1.3;
    overflow-wrap: anywhere;
  }
  .member-card__role {
    font-size: 0.9rem;
    color: rgba(244, 232, 208, 0.7);
    overflow-wrap: anywhere;
  }

  .member-card__action {
    display: inline-flex;
    align-items: center;
    /* 44px minimum target, met by height rather than font size. */
    min-height: 44px;
    margin-top: 10px;
    padding: 10px 22px;
    border-radius: 24px;
    font-size: 0.78rem;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--black);
    background: var(--lavender-soft);
    transition: background 0.3s var(--ease), transform 0.3s var(--ease);
  }
  .member-card__action:hover {
    background: var(--gold);
  }
</style>
