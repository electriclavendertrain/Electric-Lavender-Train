---
import { Image } from "astro:assets";
import familyPhoto from "../assets/images/elt-family.jpeg";
import siteConfig from "../data/siteConfig";

interface Props {
  kicker?: string | null;
  heading: string;
  paragraphs: string[];
  ctaLabel?: string | null;
}

const { kicker, heading, paragraphs, ctaLabel } = Astro.props;
const nonEmptyParagraphs = paragraphs.filter((paragraph) => paragraph && paragraph.trim().length > 0);
---

<section class="about" id="about">
  <div class="about-img reveal">
    <Image
      src={familyPhoto}
      alt={`${siteConfig.bandNameFormal} band photo`}
      width={600}
    />
  </div>
  <div class="about-copy reveal reveal-2">
    {kicker && <p class="kicker">{kicker}</p>}
    <h2>{heading}</h2>
    {nonEmptyParagraphs.map((paragraph) => <p>{paragraph}</p>)}
    {ctaLabel && (
      <a href={siteConfig.routes.about} class="btn-ghost">
        {ctaLabel} &rarr;
      </a>
    )}
  </div>
</section>

<style>
  .about {
    max-width: var(--content-max-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 70px;
    align-items: center;
  }
  .about-img {
    position: relative;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.5);
  }
  .about-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 4 / 5;
  }
  .about-img::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 18px;
    border: 1px solid rgba(160, 123, 239, 0.3);
    pointer-events: none;
  }
  .about-copy p {
    color: rgba(244, 232, 208, 0.85);
    font-weight: 300;
    margin: 20px 0 28px;
    font-size: 1.02rem;
    max-width: 520px;
  }

  @media (max-width: 860px) {
    .about {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .about-img :global(img) {
      aspect-ratio: 16 / 10;
    }
  }
  @media (max-width: 600px) {
    .about-copy {
      text-align: left;
    }
  }
</style>
