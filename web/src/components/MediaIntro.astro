---
/**
 * The Media & Merch page's opening block, and the page's only `<h1>`.
 *
 * Same compact-intro treatment as `AboutHero.astro` and `ShowsIntro.astro`:
 * clears the fixed header with top padding rather than repeating the
 * Homepage's full-height video hero, and uses `.intro-enter` (fires on load)
 * rather than `.reveal` (fires on scroll) because this block is above the
 * fold. Same `eltEnter` keyframe, duration, easing, distance and stagger as
 * every other route (global.css → "Entrance animation").
 */

interface Props {
  kicker?: string | null;
  heading: string;
  lede: string;
}

const { kicker, heading, lede } = Astro.props;
---

<section class="media-intro">
  <div class="section-inner intro-enter">
    {kicker && <p class="kicker">{kicker}</p>}
    <h1>{heading}</h1>
    <p class="media-intro__lede">{lede}</p>
  </div>
</section>

<style>
  /* Sits directly under the fixed header, which the Homepage's full-height
     hero normally clears on its own — matches ShowsIntro/AboutHero exactly. */
  .media-intro {
    padding-top: 150px;
  }

  .media-intro h1 {
    font-size: clamp(2.1rem, 5.5vw, 3.4rem);
    margin-bottom: 22px;
  }

  .media-intro__lede {
    color: rgba(244, 232, 208, 0.85);
    font-size: 1.05rem;
    font-weight: 300;
    max-width: 62ch;
  }

  @media (max-width: 900px) {
    .media-intro {
      padding-top: 120px;
    }
  }
</style>
