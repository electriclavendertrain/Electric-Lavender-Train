---
import siteConfig from "../data/siteConfig";
import type { NormalizedEventCard } from "../sanity/normalize";
import { formatEventDateTime, getEventDateParts } from "../lib/dateFormat";

interface Props {
  kicker: string;
  heading: string;
  viewAllLabel: string;
  events: NormalizedEventCard[];
  emptyStateTitle: string;
  emptyStateMessage: string;
}

const { kicker, heading, viewAllLabel, events, emptyStateTitle, emptyStateMessage } =
  Astro.props;
---

<section id="shows">
  <div class="section-inner">
    <div class="shows-head reveal">
      <div>
        <p class="kicker">{kicker}</p>
        <h2>{heading}</h2>
      </div>
      <a href={siteConfig.routes.shows} class="view-all">{viewAllLabel} &rarr;</a>
    </div>

    {
      events.length === 0 ? (
        <div class="empty-state reveal" role="status">
          <p class="empty-state__icon" aria-hidden="true">&#9835;</p>
          <h3>{emptyStateTitle}</h3>
          <p>{emptyStateMessage}</p>
        </div>
      ) : (
        <div class="shows-grid">
          {events.map((event, index) => {
            const { month, day } = getEventDateParts(event.startDateTime);
            return (
              <div class={`show-card reveal reveal-${Math.min(index + 1, 4)}`}>
                <div class="show-date">
                  <span class="m">{month}</span>
                  <span class="d">{day}</span>
                </div>
                <h3>{event.title}</h3>
                <p class="venue-city">
                  {event.venue} &middot; {event.location}
                </p>
                <span class="time">
                  {formatEventDateTime(event.startDateTime, event.endDateTime)}
                </span>
                {event.externalEventUrl && (
                  <a href={event.externalEventUrl} class="details">
                    Event Details
                  </a>
                )}
              </div>
            );
          })}
        </div>
      )
    }
  </div>
</section>

<style>
  .shows-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 20px;
    margin-bottom: 44px;
  }
  .view-all {
    font-size: 0.8rem;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--lavender-soft);
    border-bottom: 1px solid rgba(160, 123, 239, 0.5);
    padding-bottom: 2px;
  }
  .shows-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 26px;
  }
  .show-card {
    position: relative;
    background: linear-gradient(
      160deg,
      rgba(90, 62, 123, 0.18),
      rgba(11, 11, 18, 0.4)
    );
    border: 1px solid rgba(160, 123, 239, 0.25);
    border-radius: 18px;
    padding: 30px;
    transition: transform 0.35s var(--ease), border-color 0.35s,
      box-shadow 0.35s;
  }
  .show-card:hover {
    transform: translateY(-6px);
    border-color: var(--lavender);
    box-shadow: 0 20px 44px rgba(90, 62, 123, 0.35);
  }
  .show-date {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: 12px;
    background: rgba(200, 168, 107, 0.12);
    border: 1px solid rgba(200, 168, 107, 0.4);
    margin-bottom: 20px;
  }
  .show-date .m {
    font-size: 0.68rem;
    letter-spacing: 2px;
    color: var(--gold);
    text-transform: uppercase;
  }
  .show-date .d {
    font-family: var(--display);
    font-size: 1.3rem;
    color: var(--warm-white);
  }
  .show-card h3 {
    font-size: 1.15rem;
    color: var(--warm-white);
    margin-bottom: 4px;
    font-weight: 600;
  }
  .show-card .venue-city {
    color: rgba(244, 232, 208, 0.65);
    font-size: 0.9rem;
    margin-bottom: 14px;
  }
  .show-card .time {
    color: var(--lavender-soft);
    font-size: 0.85rem;
    margin-bottom: 22px;
    display: block;
  }
  .show-card .details {
    font-size: 0.78rem;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--black);
    background: var(--lavender-soft);
    display: inline-block;
    padding: 10px 20px;
    border-radius: 24px;
    transition: 0.3s;
  }
  .show-card .details:hover {
    background: var(--gold);
  }
  .empty-state {
    text-align: center;
    padding: 50px 20px;
    border: 1px dashed rgba(160, 123, 239, 0.3);
    border-radius: 18px;
  }
  .empty-state__icon {
    font-size: 1.6rem;
    color: var(--gold);
    margin-bottom: 12px;
  }
  .empty-state h3 {
    font-family: var(--display);
    font-size: 1.1rem;
    margin-bottom: 10px;
  }
  .empty-state p {
    color: rgba(244, 232, 208, 0.7);
    max-width: 420px;
    margin: 0 auto;
  }

  @media (max-width: 900px) {
    .shows-head {
      flex-direction: column;
      align-items: flex-start;
    }
    .shows-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
