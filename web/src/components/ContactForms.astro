---
/**
 * Four progressively enhanced inquiry forms. Valid submissions remain native
 * Formspree navigations; JavaScript adds validation and duplicate protection.
 * Without JavaScript, all panels and native HTML validation remain available.
 */

import {
  INQUIRY_TABS,
  DEFAULT_INQUIRY,
  fieldsByInquiry,
  contactCopy,
} from "../data/contactData";
import {
  getFormspreeEndpoint,
  HONEYPOT_FIELD_NAME,
  SUBJECT_FIELD_NAME,
  INQUIRY_TYPE_FIELD_NAME,
} from "../lib/formDelivery";
import siteConfig from "../data/siteConfig";

interface Props {
  headingId: string;
  emailConfigured: boolean;
  contactEmail: string | null;
}

const { headingId, emailConfigured, contactEmail } = Astro.props;
---

<section class="contact-forms" id={headingId} aria-labelledby={contactCopy.formsHeadingId}>
  <div class="section-inner">
    <h2 id={contactCopy.formsHeadingId} class="reveal reveal-1">{contactCopy.formsHeading}</h2>

    {
      !emailConfigured && (
        <p class="contact-forms__dev-notice reveal reveal-2" data-dev-notice>
          {contactCopy.devEmailNotice}
        </p>
      )
    }

    <p class="contact-forms__sensitive-notice reveal reveal-2">{contactCopy.sensitiveInfoNotice}</p>

    <div
      class="contact-forms__switcher"
      role="tablist"
      aria-label={contactCopy.switcherLabel}
      data-inquiry-switcher
    >
      {
        INQUIRY_TABS.map((tab) => (
          <button
            type="button"
            role="tab"
            id={`tab-${tab.value}`}
            aria-controls={`panel-${tab.value}`}
            aria-selected={tab.value === DEFAULT_INQUIRY ? "true" : "false"}
            tabindex={tab.value === DEFAULT_INQUIRY ? 0 : -1}
            class="contact-forms__tab"
            data-inquiry-tab={tab.value}
          >
            {tab.tabLabel}
          </button>
        ))
      }
    </div>

    {
      INQUIRY_TABS.map((tab) => {
        const endpoint = getFormspreeEndpoint(tab.value);
        return (
          <div
            id={`panel-${tab.value}`}
            role="tabpanel"
            aria-labelledby={`tab-${tab.value}`}
            tabindex={0}
            class="contact-forms__panel reveal reveal-3"
            data-inquiry-panel={tab.value}
          >
            <h3>{tab.panelHeading}</h3>
            {tab.panelNote && <p class="contact-forms__panel-note">{tab.panelNote}</p>}

            {
              !endpoint && (
                <p class="contact-forms__form-notice" data-form-notice>
                  {contactCopy.formNotConfiguredNotice}
                </p>
              )
            }

            <form
              method="POST"
              action={endpoint ?? undefined}
              class="contact-forms__form"
              data-inquiry-form={tab.value}
              data-delivery-configured={endpoint ? "true" : "false"}
            >
              {/* Formspree adapter fields; review with formDelivery.ts on provider changes. */}
              <input type="hidden" name={SUBJECT_FIELD_NAME} value={tab.emailSubject} />
              <input type="hidden" name={INQUIRY_TYPE_FIELD_NAME} value={tab.value} />

              {/* A visually hidden text field is required for the Formspree honeypot. */}
              <div class="visually-hidden" aria-hidden="true">
                <label>
                  Leave this field blank
                  <input type="text" name={HONEYPOT_FIELD_NAME} tabindex="-1" autocomplete="off" />
                </label>
              </div>

              <div class="field-grid">
                {fieldsByInquiry[tab.value].map((field) => {
                  const fieldId = `${tab.value}-${field.name}`;
                  const errorId = `${fieldId}-error`;
                  const helperId = `${fieldId}-helper`;
                  const describedBy = field.helperText ? `${helperId} ${errorId}` : errorId;
                  return (
                    <div class:list={["field", { "field--wide": field.type === "textarea" }]}>
                      <label for={fieldId} class="field__label">
                        {field.label}
                        {field.required ? (
                          <>
                            <span aria-hidden="true"> *</span>
                            <span class="visually-hidden">{contactCopy.requiredSuffix}</span>
                          </>
                        ) : (
                          <span class="field__optional">{contactCopy.optionalSuffix}</span>
                        )}
                      </label>

                      {field.type === "textarea" ? (
                        <textarea
                          id={fieldId}
                          name={field.submissionName ?? field.name}
                          class="field__control"
                          required={field.required}
                          maxlength={field.maxLength}
                          placeholder={field.placeholder}
                          aria-describedby={describedBy}
                          data-field
                          data-label={field.label}
                          data-merch-item-field={field.isMerchItemField}
                          rows={4}
                        />
                      ) : field.type === "select" ? (
                        <select
                          id={fieldId}
                          name={field.submissionName ?? field.name}
                          class="field__control"
                          required={field.required}
                          aria-describedby={describedBy}
                          data-field
                          data-label={field.label}
                        >
                          <option value="">Choose one…</option>
                          {field.options?.map((option) => <option value={option}>{option}</option>)}
                        </select>
                      ) : (
                        <input
                          id={fieldId}
                          name={field.submissionName ?? field.name}
                          type={field.type}
                          class="field__control"
                          required={field.required}
                          maxlength={field.maxLength}
                          autocomplete={field.autoComplete}
                          inputmode={field.inputMode}
                          placeholder={field.placeholder}
                          min={field.min}
                          max={field.max}
                          step={field.step}
                          pattern={field.pattern}
                          aria-describedby={describedBy}
                          data-field
                          data-label={field.label}
                          data-validation-kind={field.validationKind}
                          data-merch-item-field={field.isMerchItemField}
                        />
                      )}

                      {field.helperText && (
                        <p class="field__helper" id={helperId}>{field.helperText}</p>
                      )}
                      <p class="field__error" id={errorId} role="alert" hidden />
                    </div>
                  );
                })}
              </div>

              <button type="submit" class="btn btn-primary" data-inquiry-submit disabled={!endpoint}>
                <span data-submit-label>{contactCopy.submitLabel}</span>
              </button>
              <p class="contact-forms__jit-privacy">
                {contactCopy.jitPrivacyNotice}{" "}
                <a href={siteConfig.routes.privacy}>{contactCopy.privacyLinkText}</a>.
              </p>
            </form>
          </div>
        );
      })
    }

    {
      contactEmail && (
        <p class="contact-forms__direct-email reveal reveal-4">
          {contactCopy.directEmailIntro} <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
        </p>
      )
    }

    <div class="contact-forms__privacy reveal reveal-4">
      <h3>{contactCopy.privacyHeading}</h3>
      <p>{contactCopy.privacyNote}</p>
    </div>
  </div>
</section>

<script>
  import "../scripts/contactForms";
</script>

<style>
  .contact-forms h2 {
    scroll-margin-top: 110px;
  }

  .contact-forms__dev-notice {
    margin-top: 18px;
    max-width: 62ch;
    font-size: 0.9rem;
    color: rgba(244, 232, 208, 0.75);
    border-left: 2px solid rgba(200, 168, 107, 0.55);
    padding-left: 16px;
  }

  .contact-forms__sensitive-notice {
    margin-top: 18px;
    max-width: 62ch;
    font-size: 0.85rem;
    color: rgba(244, 232, 208, 0.65);
  }

  .contact-forms__panel-note {
    margin-bottom: 18px;
    margin-top: -10px;
    font-size: 0.85rem;
    color: rgba(244, 232, 208, 0.65);
  }
  .contact-forms__form-notice {
    margin-bottom: 18px;
    font-size: 0.88rem;
    color: rgba(244, 232, 208, 0.75);
    border-left: 2px solid rgba(200, 168, 107, 0.55);
    padding-left: 16px;
  }

  /* Hidden until contactForms.ts confirms it can drive the switcher — same
     progressive-enhancement pattern as .media-gallery__filters. */
  .contact-forms__switcher {
    display: none;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }
  .contact-forms__switcher.is-active {
    display: flex;
  }
  .contact-forms__tab {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 10px 22px;
    border-radius: 24px;
    font-size: 0.78rem;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--lavender-soft);
    background: rgba(160, 123, 239, 0.08);
    border: 1.5px solid rgba(160, 123, 239, 0.35);
    cursor: pointer;
    transition: background 0.3s var(--ease), border-color 0.3s var(--ease),
      color 0.3s var(--ease);
  }
  .contact-forms__tab:hover {
    border-color: var(--lavender);
    color: var(--warm-white);
  }
  /* aria-selected carries the state to assistive tech; the fill + checkmark
     are the sighted-user cue, so selection is never color-only. */
  .contact-forms__tab[aria-selected="true"] {
    color: var(--black);
    background: var(--lavender-soft);
    border-color: var(--lavender-soft);
  }
  .contact-forms__tab[aria-selected="true"]::before {
    content: "✓ ";
  }

  .contact-forms__panel {
    margin-top: 34px;
    padding: 30px;
    border-radius: 18px;
    border: 1px solid rgba(160, 123, 239, 0.25);
    background: linear-gradient(160deg, rgba(90, 62, 123, 0.14), rgba(11, 11, 18, 0.4));
  }
  /* Without JavaScript every panel is visible in document order; with it,
     contactForms.ts toggles the native `hidden` attribute — never removed
     from the DOM, never rebuilt. */
  .contact-forms__panel + .contact-forms__panel {
    margin-top: 22px;
  }
  .contact-forms__panel h3 {
    font-family: var(--display);
    font-size: 1.2rem;
    color: var(--warm-white);
    margin-bottom: 20px;
  }

  .field-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px 22px;
  }
  .field--wide {
    grid-column: 1 / -1;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .field__label {
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.3px;
    color: var(--cream);
    overflow-wrap: anywhere;
  }
  .field__optional {
    font-weight: 400;
    color: rgba(244, 232, 208, 0.55);
  }
  .field__control {
    min-height: 44px;
    padding: 10px 14px;
    border-radius: 10px;
    border: 1.5px solid rgba(160, 123, 239, 0.3);
    background: rgba(11, 11, 18, 0.6);
    color: var(--warm-white);
    font-family: var(--body);
    font-size: 0.95rem;
    transition: border-color 0.25s var(--ease), background 0.25s var(--ease);
  }
  .field__control::placeholder {
    color: rgba(244, 232, 208, 0.4);
  }
  .field__control:focus-visible {
    border-color: var(--gold);
  }
  textarea.field__control {
    min-height: 110px;
    resize: vertical;
  }
  select.field__control {
    appearance: auto;
  }
  /* Invalid state is communicated by aria-invalid + this visible border AND
     the text error below — never by color alone. */
  .field__control[aria-invalid="true"] {
    border-color: var(--burgundy);
  }
  .field__helper {
    font-size: 0.78rem;
    color: rgba(244, 232, 208, 0.55);
    overflow-wrap: anywhere;
  }
  .field__error {
    font-size: 0.8rem;
    color: #e8a5ab;
    overflow-wrap: anywhere;
  }

  .contact-forms__form > .btn {
    margin-top: 24px;
  }
  .contact-forms__form > .btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .contact-forms__jit-privacy {
    /* Exactly 15px of visible separation from the Send Inquiry button above
       — shared by all four inquiry panels (Booking/Merch/Other/Content
       Removal Request), since this is the one `.contact-forms__jit-privacy`
       rule every panel's markup uses. */
    margin-top: 15px;
    font-size: 0.78rem;
    color: rgba(244, 232, 208, 0.55);
  }
  .contact-forms__jit-privacy a {
    color: var(--lavender-soft);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .contact-forms__jit-privacy a:hover {
    color: var(--gold);
  }

  .contact-forms__direct-email {
    margin-top: 30px;
    font-size: 0.95rem;
    color: rgba(244, 232, 208, 0.85);
    overflow-wrap: anywhere;
  }
  .contact-forms__direct-email a {
    color: var(--lavender-soft);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .contact-forms__direct-email a:hover {
    color: var(--gold);
  }

  .contact-forms__privacy {
    margin-top: 30px;
    padding-top: 22px;
    border-top: 1px solid rgba(160, 123, 239, 0.15);
    max-width: 66ch;
  }
  .contact-forms__privacy h3 {
    font-family: var(--display);
    font-size: 1rem;
    color: var(--gold);
    margin-bottom: 8px;
  }
  .contact-forms__privacy p {
    font-size: 0.88rem;
    color: rgba(244, 232, 208, 0.75);
    overflow-wrap: anywhere;
  }

  @media (max-width: 700px) {
    .field-grid {
      grid-template-columns: 1fr;
    }
    .field--wide {
      grid-column: auto;
    }
    .contact-forms__panel {
      padding: 22px;
    }
  }
</style>
