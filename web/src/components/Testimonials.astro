---
import type { NormalizedTestimonial } from "../sanity/normalize";

interface Props {
  kicker: string;
  heading: string;
  items: NormalizedTestimonial[];
}

const { kicker, heading, items } = Astro.props;
---

{
  items.length > 0 && (
    <section id="testimonials">
      <div class="section-inner">
        <p class="kicker reveal">{kicker}</p>
        <h2 class="reveal heading">{heading}</h2>
        <div class="testi-grid">
          {items.map((testimonial, index) => (
            <div class={`testi-card reveal reveal-${Math.min(index + 1, 4)}`} data-key={testimonial._key}>
              <span class="quote-mark" aria-hidden="true">&ldquo;</span>
              <p>{testimonial.quote}</p>
              <p class="testi-attribution">{testimonial.attribution}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .heading {
    margin-bottom: 44px;
  }
  .testi-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }
  .testi-card {
    background: var(--cream);
    color: var(--black);
    border-radius: 20px;
    padding: 36px 30px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
    position: relative;
  }
  .quote-mark {
    font-family: var(--display);
    font-size: 2.4rem;
    color: var(--purple);
    line-height: 1;
    opacity: 0.5;
  }
  .testi-card p {
    margin: 14px 0 0;
    font-size: 0.98rem;
    color: #2b2436;
    font-weight: 400;
  }
  .testi-attribution {
    margin-top: 18px !important;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.3px;
    color: var(--purple);
  }

  @media (max-width: 900px) {
    .testi-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
