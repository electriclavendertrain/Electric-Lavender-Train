---
/**
 * The Music page's opening block, and the page's only `<h1>`. Same compact-
 * intro treatment as `MediaIntro.astro` / `ShowsIntro.astro` / `ContactIntro.astro`.
 */

interface Props {
  kicker?: string | null;
  heading: string;
  lede: string;
}

const { kicker, heading, lede } = Astro.props;
---

<section class="music-intro">
  <div class="section-inner intro-enter">
    {kicker && <p class="kicker">{kicker}</p>}
    <h1>{heading}</h1>
    <p class="music-intro__lede">{lede}</p>
  </div>
</section>

<style>
  .music-intro {
    padding-top: 150px;
  }
  .music-intro h1 {
    font-size: clamp(2.1rem, 5.5vw, 3.4rem);
    margin-bottom: 22px;
  }
  .music-intro__lede {
    color: rgba(244, 232, 208, 0.9);
    font-size: 1.05rem;
    font-weight: 300;
    max-width: 62ch;
  }

  @media (max-width: 900px) {
    .music-intro {
      padding-top: 120px;
    }
  }
</style>
