---
/** Links to a validated hosted Google Form; this site never accepts uploads. */

interface Props {
  kicker?: string | null;
  heading: string;
  explanation: string;
  ctaLabel: string;
  formUrl: string;
}

const { kicker, heading, explanation, ctaLabel, formUrl } = Astro.props;
---

<section class="event-media" aria-labelledby="event-media-heading">
  <div class="section-inner">
    {kicker && <p class="kicker reveal">{kicker}</p>}
    <h2 id="event-media-heading" class="reveal reveal-1">{heading}</h2>
    <p class="event-media__explanation reveal reveal-2">{explanation}</p>

    <a
      href={formUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="btn btn-outline event-media__cta reveal reveal-3"
    >
      {ctaLabel}
      <span class="visually-hidden"> (opens Google Forms in a new tab)</span>
    </a>
  </div>
</section>

<style>
  .event-media__explanation {
    max-width: 62ch;
    color: rgba(244, 232, 208, 0.82);
    font-weight: 300;
    margin: 18px 0 28px;
  }
</style>
