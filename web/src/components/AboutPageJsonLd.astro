---
/** Emits safely serialized MusicGroup structured data. */

import type { NormalizedBandMember } from "../sanity/normalize";
import siteConfig from "../data/siteConfig";

interface Props {
  members: readonly NormalizedBandMember[];
  /** The canonical URL of this page, as emitted by `BaseLayout`. */
  pageUrl: string;
}

const { members, pageUrl } = Astro.props;

const sameAs = [
  siteConfig.social.instagram,
  siteConfig.social.facebook,
  siteConfig.social.youtube,
  siteConfig.social.linktree,
  siteConfig.social.appleMusic,
  siteConfig.social.spotify,
].filter((url): url is string => Boolean(url));

const musicGroup = {
  "@context": "https://schema.org",
  "@type": "MusicGroup",
  name: siteConfig.bandNameFormal,
  alternateName: siteConfig.bandNameShort,
  url: pageUrl,
  ...(sameAs.length > 0 ? { sameAs } : {}),
  ...(members.length > 0
    ? {
        member: members.map((member) => ({
          "@type": "OrganizationRole",
          roleName: member.role,
          member: { "@type": "Person", name: member.name },
        })),
      }
    : {}),
};

/** Identical escaping to `PublicEventJsonLd.astro`, and for the same reason: `<`, `>` and `&` can only occur inside JSON string values, never in JSON's structural syntax, so escaping them across the whole document is safe and still produces valid JSON — and a… */
function serializeJsonLd(data: unknown): string {
  return JSON.stringify(data)
    .replace(/</g, "\\u003c")
    .replace(/>/g, "\\u003e")
    .replace(/&/g, "\\u0026")
    .replace(/\u2028/g, "\\u2028")
    .replace(/\u2029/g, "\\u2029");
}

const jsonLd = serializeJsonLd(musicGroup);
---

<script type="application/ld+json" is:inline set:html={jsonLd} />
