---
import { Image } from "astro:assets";
import logo from "../assets/images/elt-logo.jpg";
import siteConfig from "../data/siteConfig";
import { getYouTubeVideoId } from "../lib/youtube";

interface Props {
  eyebrow?: string | null;
  headline: string;
  subcopy?: string | null;
  videoUrl: string | null;
}

const { eyebrow, headline, subcopy, videoUrl } = Astro.props;

const videoId = videoUrl ? getYouTubeVideoId(videoUrl) : null;
const hasVideo = videoId !== null;
const displayEyebrow = hasVideo ? "Play Featured Video" : eyebrow;
const videoTitle = `${siteConfig.bandNameFormal} — Featured Video`;
---

<section class="hero" id="home">
  <div class="hero-overlay"></div>
  {/*
    `intro-enter` on each piece rather than the block, so the hero steps in on
    the same shared stagger every other section uses. Above the fold, so it
    runs on load rather than waiting for a scroll observer — same animation,
    different trigger (global.css → "Entrance animation").
  */}
  <div class="hero-content">
    <div class="hero-media intro-enter">
      {
        hasVideo ? (
          <button
            type="button"
            class="hero-media__trigger"
            id="hero-video-trigger"
            data-video-id={videoId}
            data-video-title={videoTitle}
          >
            <Image class="hero-logo" src={logo} alt="" width={560} loading="eager" />
            <span class="hero-media__play" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="30" height="30" fill="currentColor">
                <path d="M8 5v14l11-7z" />
              </svg>
            </span>
            <span class="visually-hidden">Play featured video</span>
          </button>
        ) : (
          <Image class="hero-logo" src={logo} alt={siteConfig.bandNameFormal} width={560} loading="eager" />
        )
      }
    </div>
    {displayEyebrow && <p class="eyebrow intro-enter intro-enter-1">{displayEyebrow}</p>}
    <h1 class="intro-enter intro-enter-2">{headline}</h1>
    {subcopy && <p class="sub intro-enter intro-enter-3">{subcopy}</p>}
    <div class="hero-buttons intro-enter intro-enter-4">
      <a href={siteConfig.routes.bookingForm} class="btn btn-primary">Book Us</a>
      <a href={siteConfig.routes.shows} class="btn btn-outline">Upcoming Shows</a>
    </div>
  </div>
  <div class="scroll-cue" aria-hidden="true"></div>
</section>

{
  hasVideo && (
    <script>
      import "../scripts/heroVideo";
    </script>
  )
}

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 140px 6% 100px;
    text-align: center;
    overflow: hidden;
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(
        ellipse at 50% 30%,
        rgba(90, 62, 123, 0.25),
        transparent 60%
      ),
      linear-gradient(
        180deg,
        rgba(11, 11, 18, 0.55) 0%,
        rgba(11, 11, 18, 0.35) 40%,
        rgba(11, 11, 18, 0.72) 100%
      );
    z-index: 1;
  }
  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 900px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 26px;
  }
  .hero-media {
    position: relative;
    max-width: 560px;
    width: 100%;
  }
  .hero-content :global(.hero-logo) {
    width: 100%;
    height: auto;
    display: block;
    filter: drop-shadow(0 0 40px rgba(160, 123, 239, 0.35))
      drop-shadow(0 10px 40px rgba(0, 0, 0, 0.5));
    border-radius: 14px;
  }
  /* Static (no-video) case: the logo is a direct child of .hero-media, so it
     floats on its own. When a video is configured, the logo is nested one
     level deeper inside .hero-media__trigger, which floats as a unit
     instead (see below) so the overlay/icon move with it. */
  .hero-media > :global(.hero-logo) {
    animation: logoFloat 7s ease-in-out infinite;
  }
  @keyframes logoFloat {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  .hero-media__trigger {
    position: relative;
    appearance: none;
    background: none;
    border: 0;
    padding: 0;
    margin: 0;
    display: block;
    width: 100%;
    font: inherit;
    color: inherit;
    cursor: pointer;
    border-radius: 14px;
    animation: logoFloat 7s ease-in-out infinite;
  }
  .hero-media__play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--warm-white);
    background: rgba(11, 11, 18, 0.38);
    border-radius: 14px;
    transition: background 0.3s var(--ease), transform 0.3s var(--ease);
  }
  .hero-media__play svg {
    filter: drop-shadow(0 4px 14px rgba(0, 0, 0, 0.6));
  }
  .hero-media__trigger:hover .hero-media__play,
  .hero-media__trigger:focus-visible .hero-media__play {
    background: rgba(11, 11, 18, 0.55);
  }
  .hero-media__trigger:hover .hero-media__play svg,
  .hero-media__trigger:focus-visible .hero-media__play svg {
    transform: scale(1.1);
  }
  .hero-media.is-playing :global(.hero-media__iframe) {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
    border-radius: 14px;
    box-shadow: 0 0 40px rgba(160, 123, 239, 0.35), 0 10px 40px rgba(0, 0, 0, 0.5);
  }

  .eyebrow {
    font-size: 0.78rem;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--gold);
    font-weight: 600;
  }
  .hero h1 {
    font-size: clamp(1.8rem, 4.2vw, 3.1rem);
    text-shadow: 0 0 30px rgba(160, 123, 239, 0.3);
  }
  .hero p.sub {
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    color: var(--cream);
    max-width: 600px;
    font-weight: 300;
  }
  .hero-buttons {
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 8px;
  }

  .scroll-cue {
    position: absolute;
    bottom: 34px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    width: 22px;
    height: 36px;
    border: 1.5px solid rgba(244, 232, 208, 0.5);
    border-radius: 14px;
  }
  .scroll-cue::before {
    content: "";
    position: absolute;
    top: 6px;
    left: 50%;
    transform: translateX(-50%);
    width: 4px;
    height: 8px;
    border-radius: 2px;
    background: var(--gold);
    animation: scrollDot 1.8s ease-in-out infinite;
  }
  @keyframes scrollDot {
    0% {
      opacity: 1;
      top: 6px;
    }
    70% {
      opacity: 0;
      top: 18px;
    }
    100% {
      opacity: 0;
      top: 6px;
    }
  }

  @media (max-width: 600px) {
    .hero {
      padding: 120px 6% 80px;
    }
    .hero-buttons {
      flex-direction: column;
      width: 100%;
    }
  }
</style>
