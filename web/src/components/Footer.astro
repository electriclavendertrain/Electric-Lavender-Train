---
/**
 * Each social/brand link renders a small local, monochrome SVG glyph via a
 * CSS mask (`mask-image` + `background-color: currentColor`) next to its
 * existing text label — never icon-only. The icon `<span>` is purely
 * decorative (`aria-hidden="true"`); the adjacent visible text is what
 * supplies each link's accessible name, completely unchanged from before.
 * Every glyph is a local file under `public/icons/social/` (Simple Icons,
 * CC0 — see `/third-party-notices/`); nothing is fetched from a remote
 * icon/CDN host at request time. `currentColor` is what lets one glyph
 * automatically track the link's own normal/hover/focus-visible color,
 * with no separate icon-specific color rule needed anywhere.
 */
import siteConfig, { contactInquiryHref } from "../data/siteConfig";

const socialLinks = [
  { key: "instagram", label: "Instagram", href: siteConfig.social.instagram },
  { key: "facebook", label: "Facebook", href: siteConfig.social.facebook },
  { key: "youtube", label: "YouTube", href: siteConfig.social.youtube },
  { key: "appleMusic", label: "Apple Music", href: siteConfig.social.appleMusic },
  { key: "spotify", label: "Spotify", href: siteConfig.social.spotify },
  { key: "linktree", label: "Linktree", href: siteConfig.social.linktree },
].filter((link): link is { key: string; label: string; href: string } => Boolean(link.href));

const year = new Date().getFullYear();

// The approved relationship sentence ends with the label's own name — split
// there so that exact name can be the link text, rather than duplicating or
// paraphrasing the approved wording (docs/client-questions.md).
const labelNotePrefix = siteConfig.heavyCrushRecords.relationshipText.replace(
  `${siteConfig.heavyCrushRecords.name}.`,
  "",
);
---

<footer>
  <div class="footer-grid">
    <div class="footer-brand">
      <p class="footer-brand__name">{siteConfig.bandNameFormal}</p>
      <p class="footer-brand__tagline">{siteConfig.tagline}</p>
      <p class="footer-brand__location">{siteConfig.location}</p>
    </div>

    <div class="footer-col">
      <h2>Navigation</h2>
      <a href={siteConfig.routes.home}>Home</a>
      <a href={siteConfig.routes.about}>About</a>
      <a href={siteConfig.routes.shows}>Shows</a>
      <a href={siteConfig.routes.music}>Music</a>
      <a href={siteConfig.routes.galleryMerch}>Gallery &amp; Merch</a>
      <a href={siteConfig.routes.contactBooking}>Contact</a>
      <a href={siteConfig.routes.faqSection}>FAQ</a>
      <a href={siteConfig.routes.newsletterSection}>Newsletter</a>
    </div>

    <div class="footer-col">
      <h2>Follow Us</h2>
      {
        socialLinks.map((link) => (
          <a href={link.href} target="_blank" rel="noopener noreferrer" class="footer-social-link">
            <span class="footer-icon" style={`--icon: url(/icons/social/${link.key}.svg)`} aria-hidden="true" />
            {link.label}
            <span class="visually-hidden"> (opens in a new tab)</span>
          </a>
        ))
      }
      {
        siteConfig.social.venmo && (
          <a
            href={siteConfig.social.venmo}
            target="_blank"
            rel="noopener noreferrer"
            class="footer-social-link"
          >
            <span class="footer-icon" style="--icon: url(/icons/social/venmo.svg)" aria-hidden="true" />
            {siteConfig.venmoLabel}
            <span class="visually-hidden"> (opens in a new tab)</span>
          </a>
        )
      }
      <p class="footer-label-note">
        {labelNotePrefix}
        <a href={siteConfig.heavyCrushRecords.url} target="_blank" rel="noopener noreferrer">
          {siteConfig.heavyCrushRecords.name}
          <span class="visually-hidden"> (opens in a new tab)</span>
        </a>.
      </p>
    </div>

    <div class="footer-col">
      <h2>Contact</h2>
      <span>{siteConfig.location}</span>
      {
        siteConfig.contact.email && (
          <a
            href={`mailto:${siteConfig.contact.email}`}
            aria-label={`Email ${siteConfig.bandNameFormal} at ${siteConfig.contact.email}`}
            class="footer-email"
          >
            {siteConfig.contact.email}
          </a>
        )
      }
      <a href={siteConfig.routes.bookingForm}>Booking Inquiries &rarr;</a>
    </div>
  </div>

  <div class="footer-bottom">
    <span>&copy; {year} {siteConfig.bandNameFormal}</span>
    <nav class="footer-legal" aria-label="Legal">
      <a href={siteConfig.routes.privacy}>Privacy Policy</a>
      <a href={siteConfig.routes.terms}>Terms of Use</a>
      <a href={siteConfig.routes.accessibility}>Accessibility</a>
      <a href={contactInquiryHref("removal")}>Content Removal Request</a>
    </nav>
    <span>Site in progress — placeholder content marked for replacement.</span>
  </div>
</footer>

<style>
  footer {
    position: relative;
    padding: 70px 6% 30px;
    background: linear-gradient(to bottom, transparent 0, var(--black) 160px);
  }
  footer::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 1px;
    background: linear-gradient(
      to right,
      transparent,
      rgba(160, 123, 239, 0.55) 18%,
      rgba(200, 168, 107, 0.4) 50%,
      rgba(160, 123, 239, 0.55) 82%,
      transparent
    );
    box-shadow: 0 0 18px 1px rgba(160, 123, 239, 0.28);
    pointer-events: none;
  }

  .footer-grid {
    position: relative;
    max-width: var(--content-max-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1.2fr;
    gap: 44px;
    padding-bottom: 44px;
  }

  .footer-brand__name {
    font-family: var(--display);
    font-size: 0.95rem;
    color: var(--cream);
    margin-bottom: 10px;
  }
  .footer-brand__tagline,
  .footer-brand__location {
    font-size: 0.85rem;
    color: rgba(244, 232, 208, 0.5);
    max-width: 260px;
    margin-bottom: 6px;
  }

  .footer-col h2 {
    font-family: var(--display);
    font-size: 0.85rem;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 18px;
    line-height: 1.3;
  }
  /* Scoped to direct children only (`>`), not every descendant span — a
     bare `.footer-col span` would also match `.footer-icon` and
     `.visually-hidden` nested inside `.footer-social-link` below, handing
     the 16px icon and the visually-hidden suffix unwanted block layout,
     padding, and margin. Every plain `.footer-col` link/label (Navigation,
     Contact's location line) is a direct child, so this scoping changes
     nothing for them. */
  .footer-col > a,
  .footer-col > span {
    display: block;
    /* Padding (not just line-height) brings the clickable/tappable area to
       WCAG 2.2 SC 2.5.8's real 24x24px Target Size (Minimum) — these are
       plain stacked list links, not inline prose, so they don't qualify for
       the criterion's "Inline" exception the way a link inside a sentence
       does (see .contact-forms__jit-privacy in ContactForms.astro for that
       case). 44px is used elsewhere on this site as a stronger internal
       goal for primary controls, not because WCAG AA requires it here. */
    padding: 3px 0;
    font-size: 0.88rem;
    color: rgba(244, 232, 208, 0.75);
    margin-bottom: 8px;
    transition: color 0.25s;
  }
  /* :focus-visible mirrors :hover's color change exactly, on top of the
     sitewide gold outline ring (global.css `:focus-visible`) — keyboard
     focus gets the same coordinated color state a mouse hover gets, plus
     its own clearly visible indicator. */
  .footer-col > a:hover,
  .footer-col > a:focus-visible {
    color: var(--lavender-soft);
  }
  /* The Follow Us links additionally carry a small icon before their text —
     every other `.footer-col > a` (Navigation, Contact) is unaffected.
     `display: flex` (not `inline-flex`): the icon and label must lay out as
     a row *within* the link, but the link itself still needs to be a
     block-level box so consecutive social links stack one per line with
     the margin-bottom above between them, instead of flowing inline and
     running into each other. */
  .footer-col > a.footer-social-link {
    display: flex;
    align-items: center;
    gap: 9px;
  }
  .footer-icon {
    flex: 0 0 auto;
    width: 16px;
    height: 16px;
    background-color: currentColor;
    /* `background-color` is the property actually animating currentColor's
       resolved value — without its own transition here, the icon would
       snap to the new color instantly while the label's `color` transition
       (above) fades, since a CSS transition only fires on the element whose
       own property value changed, not on an inherited ancestor change. */
    transition: background-color 0.25s;
    -webkit-mask-image: var(--icon);
    mask-image: var(--icon);
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-position: center;
    -webkit-mask-size: contain;
    mask-size: contain;
  }
  /* Smaller and quieter than the ordinary Follow Us links above — an
     acknowledgment, not another primary destination. */
  .footer-label-note {
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px solid rgba(160, 123, 239, 0.12);
    font-size: 0.78rem;
    color: rgba(244, 232, 208, 0.5);
  }
  .footer-label-note a {
    color: rgba(244, 232, 208, 0.65);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .footer-label-note a:hover {
    color: var(--lavender-soft);
  }
  /* The public email is deliberately conspicuous — gold, not the muted
     default link color other footer links use — since this is the site's
     primary always-available contact method. */
  .footer-email {
    color: var(--gold);
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .footer-email:hover {
    color: var(--lavender-soft);
  }

  .footer-bottom {
    position: relative;
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding-top: 26px;
    border-top: 1px solid rgba(160, 123, 239, 0.1);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px 24px;
    font-size: 0.78rem;
    color: rgba(244, 232, 208, 0.4);
  }
  .footer-legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 18px;
  }
  .footer-legal a {
    /* See the WCAG target-size note on .footer-col a above — same reasoning. */
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    color: rgba(244, 232, 208, 0.55);
    transition: color 0.25s;
  }
  .footer-legal a:hover {
    color: var(--lavender-soft);
  }

  @media (max-width: 560px) {
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (max-width: 860px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
