---
/** Renders the three-item ELT Experience section. */

import inTheRoomIcon from "../assets/icons/experience-in-the-room.svg";
import onStageIcon from "../assets/icons/experience-on-stage.svg";
import theSoundIcon from "../assets/icons/experience-the-sound.svg";

interface Props {
  headingId: string;
  kicker?: string | null;
  heading: string;
  introduction?: string | null;
  highlights: readonly { _key: string; title: string; description: string }[];
}

const { headingId, kicker, heading, introduction, highlights } = Astro.props;
const introductionText = introduction?.trim();

// The content model fixes these three semantic positions while allowing an
// editor to reword their visible titles. Keep presentation tied to position so
// an editorial wording change cannot silently remove or swap an icon.
const highlightIcons = [theSoundIcon, onStageIcon, inTheRoomIcon] as const;
---

<section class="about-experience" aria-labelledby={headingId}>
  <div class="section-inner">
    {kicker && <p class="kicker reveal">{kicker}</p>}
    <h2 id={headingId} class="reveal reveal-1">{heading}</h2>
    {
      introductionText && (
        <p class="about-experience__intro reveal reveal-2">{introductionText}</p>
      )
    }

    <ul class="about-experience__grid">
      {
        highlights.map((highlight, index) => {
          const icon = highlightIcons[index];

          return (
            <li class={`about-experience__card reveal reveal-${Math.min(index + 1, 4)}`}>
              <div class="about-experience__title-row">
                {icon && (
                  <img
                    class="about-experience__icon"
                    src={icon.src}
                    width="52"
                    height="52"
                    alt=""
                    aria-hidden="true"
                    loading="lazy"
                    decoding="async"
                  />
                )}
                <h3 class="about-experience__title">{highlight.title}</h3>
              </div>
              <p class="about-experience__description">{highlight.description}</p>
            </li>
          );
        })
      }
    </ul>

  </div>
</section>

<style>
  .about-experience h2 {
    margin-bottom: 22px;
  }
  .about-experience__intro {
    color: rgba(244, 232, 208, 0.85);
    font-size: 1.02rem;
    font-weight: 300;
    max-width: 66ch;
    overflow-wrap: anywhere;
  }

  .about-experience__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 26px;
    margin-top: 44px;
    list-style: none;
  }

  .about-experience__card {
    padding: 30px;
    border-radius: 18px;
    border: 1px solid rgba(160, 123, 239, 0.25);
    background: linear-gradient(160deg, rgba(90, 62, 123, 0.18), rgba(11, 11, 18, 0.4));
  }
  .about-experience__title-row {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 14px;
  }
  .about-experience__icon {
    width: 52px;
    height: 52px;
    flex: 0 0 52px;
    object-fit: contain;
  }
  .about-experience__title {
    font-size: 0.78rem;
    letter-spacing: 3px;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--gold);
    margin: 0;
    overflow-wrap: anywhere;
  }
  .about-experience__description {
    color: rgba(244, 232, 208, 0.82);
    font-size: 0.98rem;
    font-weight: 300;
    overflow-wrap: anywhere;
  }
  /* Two columns would leave a stranded third card, and three narrow columns
     below this width make the descriptions unreadably thin — so it goes
     straight to one. */
  @media (max-width: 900px) {
    .about-experience__grid {
      grid-template-columns: 1fr;
      gap: 18px;
    }
  }
</style>
