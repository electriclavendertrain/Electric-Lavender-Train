---
/** Small, reusable progress indicator adapted to ELT's visual system. */

interface Props {
  class?: string;
  label?: string;
  announce?: boolean;
}

const { class: className, label = "Loading", announce = false } = Astro.props;
---

<span
  class:list={["loading-dots", className]}
  role={announce ? "status" : undefined}
  aria-live={announce ? "polite" : undefined}
  aria-label={announce ? label : undefined}
  aria-hidden={announce ? undefined : "true"}
>
  <span class="loading-dots__dot"></span>
  <span class="loading-dots__dot"></span>
  <span class="loading-dots__dot"></span>
</span>

<style>
  .loading-dots {
    --loading-dots-duration: 1.2s;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.42em;
    width: 3.5rem;
    color: var(--gold);
  }

  .loading-dots__dot {
    width: 0.58rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 12px rgba(217, 188, 124, 0.38);
    animation: loading-dot-blink var(--loading-dots-duration) ease-in-out infinite;
  }

  .loading-dots__dot:nth-child(2) {
    animation-delay: calc(var(--loading-dots-duration) / 6);
  }

  .loading-dots__dot:nth-child(3) {
    animation-delay: calc(var(--loading-dots-duration) / 3);
  }

  @keyframes loading-dot-blink {
    0%,
    70%,
    100% {
      opacity: 0.28;
      transform: scale(0.78);
    }
    35% {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .loading-dots__dot {
      animation: none;
      opacity: 0.8;
      transform: none;
    }
  }
</style>
