---
/**
 * Links to the one hosted signup form and, independently, the one hosted
 * unsubscribe form. Each fails closed on its own: a visitor can always find
 * whichever is actually configured, so an opt-out link never disappears
 * merely because signup is temporarily unavailable, and vice versa.
 */
interface Props {
  kicker?: string | null;
  heading: string;
  body: string;
  ctaLabel: string;
  /** `null` when no valid hosted signup URL is configured yet. */
  signupUrl: string | null;
  /** `null` when no valid hosted unsubscribe URL is configured yet. */
  unsubscribeUrl: string | null;
}

const { kicker, heading, body, ctaLabel, signupUrl, unsubscribeUrl } = Astro.props;
---

<section id="newsletter" class="newsletter">
  <div class="section-inner">
    <div class="newsletter__panel reveal">
      {kicker && <p class="kicker">{kicker}</p>}
      <h2>{heading}</h2>
      <p class="newsletter__body">{body}</p>

      {
        signupUrl && (
          <a
            href={signupUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary newsletter__cta"
          >
            {ctaLabel}
            <span class="visually-hidden"> (opens in a new tab)</span>
          </a>
        )
      }

      {
        unsubscribeUrl && (
          <p class="newsletter__unsubscribe">
            <a href={unsubscribeUrl} target="_blank" rel="noopener noreferrer">
              Unsubscribe from newsletter
              <span class="visually-hidden"> (opens in a new tab)</span>
            </a>
          </p>
        )
      }
    </div>
  </div>
</section>

<style>
  .newsletter__panel {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
    padding: 48px 6%;
    border-radius: 22px;
    border: 1px solid rgba(160, 123, 239, 0.22);
    background: linear-gradient(160deg, rgba(90, 62, 123, 0.16), rgba(11, 11, 18, 0.4));
  }
  .newsletter__panel .kicker {
    justify-content: center;
  }
  /* The shared `.kicker` primitive (global.css) only draws its bar after the
     text — fine for every left-aligned kicker sitewide, but this is the one
     kicker centered as a group (`justify-content: center` above), where a
     single trailing bar reads lopsided. Scoped to this panel only, so every
     other kicker on the site keeps its normal one-sided treatment. */
  .newsletter__panel .kicker::before {
    content: "";
    flex: 0 0 40px;
    height: 1px;
    background: var(--gold);
    opacity: 0.5;
  }
  .newsletter__body {
    max-width: 58ch;
    margin: 18px auto 28px;
    color: rgba(244, 232, 208, 0.85);
    font-weight: 300;
  }
  .newsletter__cta {
    margin: 0 auto;
  }
  /* Deliberately smaller and quieter than .newsletter__cta — an opt-out is a
     real, always-findable action, but never the visual peer of signup. */
  .newsletter__unsubscribe {
    margin: 18px 0 0;
    font-size: 0.8rem;
  }
  .newsletter__unsubscribe a {
    color: rgba(244, 232, 208, 0.6);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .newsletter__unsubscribe a:hover,
  .newsletter__unsubscribe a:focus-visible {
    color: var(--gold);
  }

  @media (max-width: 600px) {
    .newsletter__panel {
      padding: 36px 6%;
    }
  }
</style>
