---
import siteConfig from "../data/siteConfig";

interface Props {
  kicker?: string | null;
  heading: string;
  body: string;
  ctaLabel: string;
  /** Adds a matching rule before the centered kicker. Off by default so
   * existing uses keep their approved appearance. */
  balancedKicker?: boolean;
  /**
   * Where the button goes. Defaults to the shared booking-form destination,
   * so every existing caller (Homepage, Shows, About) keeps its current
   * behavior with no changes. The Media & Merch page is the first caller to
   * override this, passing the verified Instagram URL.
   */
  href?: string;
  /**
   * Marks `href` as an external destination: opens in a new tab and appends
   * the standard visually-hidden new-tab notice to the accessible name,
   * matching every other external link in the project (Footer, Testimonials,
   * member links). Off by default — the existing booking-form destination is
   * an internal route and must not gain `target="_blank"`.
   */
  isExternal?: boolean;
}

const {
  kicker,
  heading,
  body,
  ctaLabel,
  balancedKicker = false,
  href = siteConfig.routes.bookingForm,
  isExternal = false,
} = Astro.props;
---

<section class="cta" id="contact">
  <div class="cta-blob" aria-hidden="true"></div>
  {kicker && (
    <p class:list={["kicker", "centered", { "centered--balanced": balancedKicker }]}>
      {balancedKicker && <span class="kicker__leading-rule" aria-hidden="true"></span>}
      <span>{kicker}</span>
    </p>
  )}
  <h2 class="reveal reveal-1">{heading}</h2>
  <p class="reveal reveal-2">{body}</p>
  <a
    href={href}
    class="btn btn-primary reveal reveal-3"
    target={isExternal ? "_blank" : undefined}
    rel={isExternal ? "noopener noreferrer" : undefined}
  >
    {ctaLabel}
    {isExternal && <span class="visually-hidden"> (opens in a new tab)</span>}
  </a>
</section>

<style>
  .cta {
    position: relative;
    text-align: center;
    padding: 130px 6%;
    overflow: hidden;
    background: radial-gradient(
        ellipse at 30% 20%,
        rgba(90, 62, 123, 0.5),
        transparent 55%
      ),
      radial-gradient(ellipse at 75% 80%, rgba(160, 123, 239, 0.3), transparent 55%),
      rgba(46, 33, 64, 0.5);
  }
  .cta-blob {
    position: absolute;
    top: -100px;
    left: 10%;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    background: var(--purple);
    filter: blur(80px);
    opacity: 0.25;
    pointer-events: none;
    z-index: 0;
  }
  .kicker.centered {
    justify-content: center;
  }
  .kicker__leading-rule {
    flex: 0 0 40px;
    height: 1px;
    background: var(--gold);
    opacity: 0.5;
  }
  .cta h2 {
    position: relative;
    z-index: 1;
    font-size: clamp(1.8rem, 4vw, 2.9rem);
    max-width: 760px;
    margin: 0 auto 26px;
  }
  .cta p {
    position: relative;
    z-index: 1;
    color: rgba(244, 232, 208, 0.8);
    max-width: 520px;
    margin: 0 auto 36px;
    font-weight: 300;
  }
  .cta .btn {
    position: relative;
    z-index: 1;
  }
</style>
