---
/**
 * "Our story" — one to four short paragraphs, capped and blank-filtered during
 * normalization. Narrow measure, no image; the page has already shown one.
 */

interface Props {
  headingId: string;
  kicker?: string | null;
  heading: string;
  paragraphs: readonly string[];
}

const { headingId, kicker, heading, paragraphs } = Astro.props;
---

<section class="about-story" aria-labelledby={headingId}>
  <div class="section-inner">
    {kicker && <p class="kicker reveal">{kicker}</p>}
    <h2 id={headingId} class="reveal reveal-1">{heading}</h2>
    {
      paragraphs.map((paragraph, index) => (
        <p class={`about-story__paragraph reveal reveal-${Math.min(index + 2, 4)}`}>
          {paragraph}
        </p>
      ))
    }
  </div>
</section>

<style>
  .about-story h2 {
    margin-bottom: 28px;
  }
  .about-story__paragraph {
    color: rgba(244, 232, 208, 0.85);
    font-size: 1.02rem;
    font-weight: 300;
    max-width: 66ch;
    margin-bottom: 20px;
    overflow-wrap: anywhere;
  }
  .about-story__paragraph:last-child {
    margin-bottom: 0;
  }
</style>
