---
/** Renders the curated Homepage photo grid. */

import siteConfig from "../data/siteConfig";
import LoadingDots from "./LoadingDots.astro";
import { aboutPageCopy, memberDialogIdFor } from "../data/aboutData";
import type { NormalizedOfficialBandPhoto } from "../sanity/normalize";

interface Props {
  kicker?: string | null;
  heading: string;
  body?: string | null;
  ctaLabel: string;
  photos: NormalizedOfficialBandPhoto[];
}

const { kicker, heading, body, ctaLabel, photos } = Astro.props;

const memberProfileHref = (photo: NormalizedOfficialBandPhoto) =>
  `${siteConfig.routes.about}#${memberDialogIdFor(photo.member._id)}`;
---

<section class="official-band-photos" aria-labelledby="official-band-photos-heading">
  <div class="section-inner">
    {kicker && <p class="kicker reveal">{kicker}</p>}
    <h2 id="official-band-photos-heading" class="reveal reveal-1">{heading}</h2>
    {body && <p class="official-band-photos__body reveal reveal-2">{body}</p>}

    <ul class="official-band-photos__grid reveal reveal-3">
      {
        photos.map((photo) => (
          <li class="official-band-photos__cell" data-image-load-state="loading">
            <a
              class="official-band-photos__link"
              href={memberProfileHref(photo)}
              aria-label={`${aboutPageCopy.memberCardActionPrefix} ${photo.member.name}`}
            >
              <img
                src={photo.src}
                srcset={photo.srcSet}
                sizes={photo.sizes}
                width={photo.width}
                height={photo.height}
                alt={photo.alt}
                decoding="async"
                data-image-load-target
                style={`--focal-point: ${photo.objectPosition}`}
              />
              <LoadingDots class="image-load__loader" />
              <span class="image-load__error">Image unavailable</span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="official-band-photos__cta reveal reveal-4">
      <a href={siteConfig.routes.about} class="btn btn-ghost">
        {ctaLabel} &rarr;
      </a>
    </div>
  </div>
</section>

<script>
  import "../scripts/imageLoadState";
</script>

<style>
  .official-band-photos__body {
    color: rgba(244, 232, 208, 0.85);
    font-size: 1.02rem;
    font-weight: 300;
    max-width: 66ch;
    margin-top: 12px;
    overflow-wrap: anywhere;
  }

  .official-band-photos__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 22px;
    margin-top: 40px;
    list-style: none;
  }

  .official-band-photos__cta {
    margin-top: 40px;
  }

  .official-band-photos__cell {
    position: relative;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
    /* Visible behind the loading dots while the photo is still loading. */
    background: rgba(11, 11, 18, 0.58);
  }
  .official-band-photos__cell::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 18px;
    border: 1px solid rgba(160, 123, 239, 0.25);
    pointer-events: none;
  }

  .official-band-photos__link {
    display: block;
    height: 100%;
  }
  .official-band-photos__link:focus-visible {
    outline: 3px solid var(--gold);
    outline-offset: -4px;
  }

  .official-band-photos__cell img {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: var(--focal-point, 50% 50%);
    transition: transform 0.4s var(--ease), filter 0.4s var(--ease),
      opacity 0.2s var(--ease);
  }
  .official-band-photos__link:hover img {
    transform: scale(1.035);
    filter: brightness(1.06);
  }

  @media (max-width: 900px) {
    .official-band-photos__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .official-band-photos__grid {
      grid-template-columns: 1fr;
    }
    .official-band-photos__cell img {
      aspect-ratio: 16 / 10;
    }
  }
</style>
