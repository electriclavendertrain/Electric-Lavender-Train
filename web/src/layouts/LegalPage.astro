---
/**
 * Shared layout for the Privacy Policy, Terms of Use, and Accessibility
 * pages — one prose treatment defined once, rather than tripled across
 * three near-identical page files. Each page supplies its own heading/
 * effective date via props and its own body content via the default slot,
 * written as plain semantic HTML (h2/p/ul/ol) styled by `.legal-prose`
 * below.
 */

import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  kicker: string;
  heading: string;
  effectiveDate: string;
}

const { title, description, kicker, heading, effectiveDate } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <section class="legal-page">
    <div class="section-inner intro-enter">
      <p class="kicker">{kicker}</p>
      <h1>{heading}</h1>
      <p class="legal-page__effective-date">Effective {effectiveDate}</p>
      <div class="legal-prose">
        <slot />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .legal-page {
    padding-top: 150px;
  }
  @media (max-width: 900px) {
    .legal-page {
      padding-top: 120px;
    }
  }

  .legal-page h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: 10px;
  }

  .legal-page__effective-date {
    font-size: 0.85rem;
    color: rgba(244, 232, 208, 0.55);
    margin-bottom: 44px;
  }

  .legal-prose {
    max-width: 74ch;
  }
  .legal-prose :global(h2) {
    font-family: var(--display);
    font-size: 1.25rem;
    color: var(--gold);
    margin: 40px 0 14px;
  }
  .legal-prose :global(h2:first-child) {
    margin-top: 0;
  }
  .legal-prose :global(h3) {
    font-family: var(--display);
    font-size: 1.02rem;
    color: var(--warm-white);
    margin: 24px 0 10px;
  }
  .legal-prose :global(p) {
    margin-bottom: 16px;
    color: rgba(244, 232, 208, 0.85);
    line-height: 1.75;
  }
  .legal-prose :global(ul),
  .legal-prose :global(ol) {
    margin: 0 0 16px 1.4em;
  }
  .legal-prose :global(ul li) {
    list-style: disc;
  }
  .legal-prose :global(ol li) {
    list-style: decimal;
  }
  .legal-prose :global(li) {
    margin-bottom: 8px;
    color: rgba(244, 232, 208, 0.85);
    line-height: 1.65;
  }
  .legal-prose :global(a) {
    color: var(--lavender-soft);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .legal-prose :global(a:hover) {
    color: var(--gold);
  }
  .legal-prose :global(strong) {
    color: var(--warm-white);
  }
  .legal-prose :global(blockquote) {
    margin: 0 0 16px;
    padding-left: 16px;
    border-left: 2px solid rgba(200, 168, 107, 0.55);
    color: rgba(244, 232, 208, 0.75);
    font-size: 0.92rem;
  }
</style>
