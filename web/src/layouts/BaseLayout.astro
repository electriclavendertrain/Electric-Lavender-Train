---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import siteConfig from "../data/siteConfig";
import "../styles/global.css";
import "../styles/cursors.css";

/** Shared document shell, metadata, navigation, footer, and reveal behavior. */
import "@fontsource/jost/latin-300.css";
import "@fontsource/jost/latin-400.css";
import "@fontsource/jost/latin-500.css";
import "@fontsource/jost/latin-600.css";
import "@fontsource/jost/latin-700.css";
import "@fontsource/jost/latin-400-italic.css";
import "@fontsource/ultra/latin-400.css";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string | null;
  /** Error/system pages can opt out without changing normal route metadata. */
  noIndex?: boolean;
}

const {
  title = `${siteConfig.bandNameFormal} (${siteConfig.bandNameShort}) — ${siteConfig.tagline}`,
  description = siteConfig.tagline,
  ogImage = null,
  noIndex = false,
} = Astro.props;

/** One canonical URL per route, derived here rather than passed in by each page — a page cannot forget it, and it cannot disagree with the route it is actually built at. */
const canonicalPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const canonicalUrl = new URL(canonicalPath, siteConfig.siteUrl).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-16x16.png" sizes="16x16" />
    <link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    {!noIndex && <link rel="canonical" href={canonicalUrl} />}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {!noIndex && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:site_name" content={siteConfig.bandNameFormal} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <script is:inline>
      // Enable reveal styles before first paint; no-JS content remains visible.
      document.documentElement.classList.add("js-reveal");
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <div class="stars" aria-hidden="true"></div>
    <div class="nebula-blob b1" aria-hidden="true"></div>
    <div class="nebula-blob b2" aria-hidden="true"></div>
    <div class="track" aria-hidden="true">
      <div class="spark" id="track-spark"></div>
    </div>

    <Header />

    <main id="main-content">
      <slot />
    </main>

    <Footer />

    <script>
      import "../scripts/reveal";
    </script>
  </body>
</html>
