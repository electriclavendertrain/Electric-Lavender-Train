PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=

# Public Formspree endpoints, one per inquiry type. Invalid or empty values
# disable only that form and preserve the direct-email fallback.
PUBLIC_FORMSPREE_BOOKING_ENDPOINT=
PUBLIC_FORMSPREE_MERCH_ENDPOINT=
PUBLIC_FORMSPREE_OTHER_ENDPOINT=
PUBLIC_FORMSPREE_REMOVAL_ENDPOINT=

# Public HTTPS URL for the Brevo-hosted, double-opt-in signup form. An empty
# or invalid value shows a configuration notice instead of a signup link.
PUBLIC_NEWSLETTER_SIGNUP_URL=

# Public HTTPS URL for the Brevo-hosted unsubscribe form. Independent of the
# signup URL above — an empty or invalid value simply omits the unsubscribe
# link, even while signup remains available (and vice versa).
PUBLIC_NEWSLETTER_UNSUBSCRIBE_URL=
