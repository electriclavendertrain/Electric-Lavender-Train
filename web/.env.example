PUBLIC_SANITY_PROJECT_ID=4bysltwo
PUBLIC_SANITY_DATASET=development

# Formspree endpoints — one per inquiry type (Booking/Merch/Other/Content
# Removal Request), from one Formspree project's four separately
# configurable forms. Format: https://formspree.io/f/<form id> — get the
# real value from each form's Formspree dashboard page after creating it.
# Do NOT fill in a placeholder-shaped fake value; an empty or invalid entry
# correctly makes that inquiry type's form render disabled (direct email
# fallback shown instead) rather than silently failing submissions — each
# of the four is configured independently, so any one of them can go live
# on its own schedule — see docs/contact-booking.md.
PUBLIC_FORMSPREE_BOOKING_ENDPOINT=
PUBLIC_FORMSPREE_MERCH_ENDPOINT=
PUBLIC_FORMSPREE_OTHER_ENDPOINT=
PUBLIC_FORMSPREE_REMOVAL_ENDPOINT=

# Public (not secret) URL of the hosted, double-opt-in newsletter signup page
# — planned as a Brevo-hosted form, but this project never hardcodes a
# provider name into its code, only this one URL. Must be a real https://
# link once configured; do NOT fill in a placeholder-shaped fake value. Left
# empty deliberately: no hosted signup page has been created yet. An empty
# or invalid value correctly makes the newsletter section render its
# development/configuration notice instead of a link that would otherwise
# look functional — see web/src/lib/newsletter.ts.
PUBLIC_NEWSLETTER_SIGNUP_URL=