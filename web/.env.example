PUBLIC_SANITY_PROJECT_ID=4bysltwo
PUBLIC_SANITY_DATASET=development

# Formspree endpoints — one per inquiry type (Booking/Merch/Other), from one
# Formspree project's three separately configurable forms. Format:
# https://formspree.io/f/<form id> — get the real value from each form's
# Formspree dashboard page after creating it. Do NOT fill in a placeholder-
# shaped fake value; an empty or invalid entry correctly makes that inquiry
# type's form render disabled (direct email fallback shown instead) rather
# than silently failing submissions — see docs/contact-booking.md.
PUBLIC_FORMSPREE_BOOKING_ENDPOINT=
PUBLIC_FORMSPREE_MERCH_ENDPOINT=
PUBLIC_FORMSPREE_OTHER_ENDPOINT=